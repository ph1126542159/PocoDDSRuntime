{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.dev/contracts/framework-change-impact.schema.json",
  "title": "PocoDDSRuntime framework change impact plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "catalogSha256", "fullSuite", "docsOnly",
    "changedPaths", "fullSuiteReasons", "owners", "buildTargets", "testLabels",
    "ctestLabelRegex", "components"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": { "const": "framework-change-impact" },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "fullSuite": { "type": "boolean" },
    "docsOnly": { "type": "boolean" },
    "changedPaths": { "$ref": "#/$defs/stringList" },
    "fullSuiteReasons": { "$ref": "#/$defs/stringList" },
    "owners": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^team/[a-z0-9][a-z0-9-]*$" }
    },
    "buildTargets": { "$ref": "#/$defs/stringList" },
    "testLabels": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "ctestLabelRegex": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "owner", "reason", "buildTargets", "testLabels"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "owner": { "type": "string", "pattern": "^team/[a-z0-9][a-z0-9-]*$" },
          "reason": { "enum": ["changed", "dependency", "framework-wide"] },
          "buildTargets": { "$ref": "#/$defs/stringList" },
          "testLabels": { "$ref": "#/$defs/stringList" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stringList": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
