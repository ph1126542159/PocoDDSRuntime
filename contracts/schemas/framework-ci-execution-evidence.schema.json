{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.dev/contracts/framework-ci-execution-evidence.schema.json",
  "title": "PocoDDSRuntime framework CI execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "reportSha256", "selection", "fullSuitePassed",
    "passedLabels", "executedTestCount", "executedTests", "ctestConfig",
    "ctestCatalogSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": { "const": "framework-ci-execution-evidence" },
    "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selection": { "enum": ["full-suite", "affected-labels"] },
    "fullSuitePassed": { "type": "boolean" },
    "passedLabels": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "executedTestCount": { "type": "integer", "minimum": 1 },
    "executedTests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "ctestConfig": { "type": "string", "minLength": 1 },
    "ctestCatalogSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approvedOwners": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^team/[a-z0-9][a-z0-9-]*$" }
    }
  }
}
