{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-leader-backend-capability-report.schema.json",
  "title": "Registry leader backend capability negotiation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "passed", "backendId", "authorityId", "registryId", "backendConfigSha256", "implementationId", "protocolMajor", "protocolMinor", "requiredCapabilities", "capabilities", "capabilityManifestSha256", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryLeaderBackendCapabilityReport"},
    "passed": {"const": true},
    "backendId": {"$ref": "#/$defs/id"},
    "authorityId": {"$ref": "#/$defs/id"},
    "registryId": {"$ref": "#/$defs/id"},
    "backendConfigSha256": {"$ref": "#/$defs/sha256"},
    "implementationId": {"$ref": "#/$defs/id"},
    "protocolMajor": {"type": "integer", "minimum": 1, "maximum": 65535},
    "protocolMinor": {"type": "integer", "minimum": 0, "maximum": 65535},
    "requiredCapabilities": {"$ref": "#/$defs/capabilities"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "capabilityManifestSha256": {"$ref": "#/$defs/sha256"},
    "checkedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}}
  }
}
