{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-fleet-executor-request.schema.json",
  "title": "Adapter Catalog Fleet node operation request", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "executorId", "rolloutId", "nodeId", "operation", "catalogId", "candidateCatalogGeneration", "candidateCatalogSha256", "expectedActivationGeneration"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogFleetExecutorRequest"}, "requestId": {"type": "string", "format": "uuid"}, "executorId": {"$ref": "#/$defs/id"}, "rolloutId": {"$ref": "#/$defs/pathId"}, "nodeId": {"$ref": "#/$defs/pathId"}, "operation": {"enum": ["deploy", "revert", "status"]}, "catalogId": {"$ref": "#/$defs/id"}, "candidateCatalogGeneration": {"type": "integer", "minimum": 2}, "candidateCatalogSha256": {"$ref": "#/$defs/sha256"}, "expectedActivationGeneration": {"type": "integer", "minimum": 1}},
  "$defs": {"pathId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
