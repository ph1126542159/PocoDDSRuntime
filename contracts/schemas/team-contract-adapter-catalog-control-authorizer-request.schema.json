{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-control-authorizer-request.schema.json",
  "title": "Sanitized Adapter Catalog Fleet control authorization request", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "authorizerId", "authorizationId", "rolloutId", "operationId", "action", "claimedActor", "reasonSha256", "expectedControlGeneration", "waveId", "waveIndex", "catalogId", "candidateCatalogGeneration", "candidateCatalogSha256", "gateEvidenceSha256"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogControlAuthorizerRequest"}, "requestId": {"type": "string", "format": "uuid"}, "authorizerId": {"$ref": "#/$defs/id"}, "authorizationId": {"$ref": "#/$defs/id"}, "rolloutId": {"$ref": "#/$defs/pathId"}, "operationId": {"$ref": "#/$defs/id"}, "action": {"enum": ["resume", "abort"]}, "claimedActor": {"$ref": "#/$defs/id"}, "reasonSha256": {"$ref": "#/$defs/sha256"}, "expectedControlGeneration": {"type": "integer", "minimum": 0, "maximum": 100}, "waveId": {"$ref": "#/$defs/pathId"}, "waveIndex": {"type": "integer", "minimum": 0, "maximum": 31}, "catalogId": {"$ref": "#/$defs/id"}, "candidateCatalogGeneration": {"type": "integer", "minimum": 2}, "candidateCatalogSha256": {"$ref": "#/$defs/sha256"}, "gateEvidenceSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}},
  "$defs": {"pathId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
