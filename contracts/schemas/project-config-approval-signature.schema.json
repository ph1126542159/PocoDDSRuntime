{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/project-config-approval-signature.schema.json",
  "title": "PocoDDSRuntime project configuration approval signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "product", "algorithm", "approverId", "keyId",
    "manifestSha256", "signature"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeProjectConfiguration"},
    "algorithm": {"const": "Ed25519"},
    "approverId": {"type": "string", "minLength": 1},
    "keyId": {"type": "string", "minLength": 1},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "minLength": 1}
  }
}
