{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.local/schemas/release-artifact-manifest.schema.json",
  "title": "PocoDDSRuntime signed release artifact manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "product", "version", "gitCommit", "dirty",
    "generatedAt", "files", "sbom", "provenance"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntime"},
    "version": {"type":"string","minLength":1},
    "gitCommit": {"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64}|unknown)$"},
    "dirty": {"type":"boolean"},
    "generatedAt": {"type":"string","format":"date-time"},
    "files": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["path","size","sha256"],
        "properties": {
          "path":{"type":"string","minLength":1},
          "size":{"type":"integer","minimum":0},
          "sha256":{"$ref":"#/$defs/sha256"}
        }
      }
    },
    "sbom": {
      "type":"object","additionalProperties":false,
      "required":["path","sha256","spdxVersion","documentNamespace"],
      "properties": {
        "path":{"const":"pocoddsruntime.spdx.json"},
        "sha256":{"$ref":"#/$defs/sha256"},
        "spdxVersion":{"const":"SPDX-2.3"},
        "documentNamespace":{"type":"string","minLength":1}
      }
    },
    "provenance": {
      "type":"object","additionalProperties":false,
      "required":["builderId","buildProfile","artifactSetSha256","source"],
      "properties": {
        "builderId":{"type":"string","minLength":1},
        "buildProfile":{"type":"string","minLength":1},
        "artifactSetSha256":{"$ref":"#/$defs/sha256"},
        "source": {
          "type":"object","additionalProperties":false,
          "required":["gitCommit","dirty"],
          "properties": {
            "gitCommit":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64}|unknown)$"},
            "dirty":{"type":"boolean"}
          }
        }
      }
    }
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
