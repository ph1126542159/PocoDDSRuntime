{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-secret-provider-request.schema.json",
  "title": "Secret Provider request", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "providerId", "operation", "reference"],
  "properties": {"schemaVersion": {"enum": [1, 2]}, "product": {"const": "PocoDDSRuntimeTeamContractSecretProviderRequest"}, "requestId": {"$ref": "#/$defs/id"}, "providerId": {"$ref": "#/$defs/id"}, "operation": {"enum": ["resolve", "lease"]}, "reference": {"$ref": "team-contract-secret-reference.schema.json"}, "requestedLeaseSeconds": {"type": "integer", "minimum": 2, "maximum": 3600}},
  "allOf": [{"if": {"properties": {"schemaVersion": {"const": 2}}}, "then": {"properties": {"operation": {"const": "lease"}}, "required": ["requestedLeaseSeconds"]}, "else": {"properties": {"operation": {"const": "resolve"}}, "not": {"required": ["requestedLeaseSeconds"]}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
