{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-fleet-executor-response.schema.json",
  "title": "Adapter Catalog Fleet node operation response", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "executorId", "rolloutId", "nodeId", "operation", "accepted", "state", "currentActivationGeneration", "reconcileReportSha256", "diagnosticCode"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogFleetExecutorResponse"}, "requestId": {"type": "string", "format": "uuid"}, "executorId": {"$ref": "#/$defs/id"}, "rolloutId": {"$ref": "#/$defs/pathId"}, "nodeId": {"$ref": "#/$defs/pathId"}, "operation": {"enum": ["deploy", "revert", "status"]}, "accepted": {"type": "boolean"}, "state": {"enum": ["committed", "rolled-back", "failed", "unknown"]}, "currentActivationGeneration": {"type": "integer", "minimum": 1}, "reconcileReportSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "diagnosticCode": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}},
  "$defs": {"pathId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
