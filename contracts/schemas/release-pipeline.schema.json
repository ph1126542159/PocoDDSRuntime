{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/contracts/release-pipeline.schema.json",
  "title": "PocoDDSRuntime resumable release pipeline plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pipelineId", "sourceRoot", "buildRoot", "stages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pipelineId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sourceRoot": { "type": "string", "minLength": 1 },
    "buildRoot": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "stages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "workingDirectory": { "type": "string" },
          "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 },
          "requiredInputs": { "type": "array", "items": { "type": "string" } },
          "requiredOutputs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
