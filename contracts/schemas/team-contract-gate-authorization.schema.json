{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-gate-authorization.schema.json",
  "title": "Signed aggregate authorization of a fully revalidated team contract Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "product", "operation", "decision", "authorizationId", "registryId",
    "channels", "gateReportSha256", "candidateLockSha256", "impactReportSha256",
    "executionEvidenceSha256", "runnerAttestationSha256", "issuedAt", "expiresAt",
    "authorizerId", "keyId", "signature"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractGateAuthorization"},
    "operation": {"const": "team-contract-gate-authorize"},
    "decision": {"const": "approve"},
    "authorizationId": {"$ref": "#/$defs/id"},
    "registryId": {"$ref": "#/$defs/id"},
    "channels": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "gateReportSha256": {"$ref": "#/$defs/sha256"},
    "candidateLockSha256": {"$ref": "#/$defs/sha256"},
    "impactReportSha256": {"$ref": "#/$defs/sha256"},
    "executionEvidenceSha256": {"$ref": "#/$defs/sha256"},
    "runnerAttestationSha256": {"$ref": "#/$defs/sha256"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "authorizerId": {"$ref": "#/$defs/id"},
    "keyId": {"$ref": "#/$defs/id"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
