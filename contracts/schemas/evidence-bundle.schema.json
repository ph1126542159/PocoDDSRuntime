{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/contracts/evidence-bundle.schema.json",
  "title": "PocoDDSRuntime signed evidence bundle manifest",
  "type": "object",
  "required": ["schemaVersion", "product", "createdAt", "qualificationVerdict",
               "releaseApproved", "includesArtifacts", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "PocoDDSRuntimeEvidenceBundle" },
    "createdAt": { "type": "string", "format": "date-time" },
    "qualificationVerdict": {
      "enum": ["LOCAL_VALIDATION_PASSED", "RELEASE_CANDIDATE_APPROVED"]
    },
    "releaseApproved": { "type": "boolean" },
    "includesArtifacts": { "type": "boolean" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "additionalProperties": true
}
