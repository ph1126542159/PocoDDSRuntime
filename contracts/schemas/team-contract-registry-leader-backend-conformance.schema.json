{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-leader-backend-conformance.schema.json",
  "title": "Registry leader authority backend conformance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "passed", "backendId", "authorityId", "registryId", "backendConfigSha256", "backendProtocol", "capabilityManifestSha256", "startedAt", "completedAt", "finalFencingToken", "finalGrantSha256", "checks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryLeaderBackendConformance"},
    "passed": {"const": true},
    "backendId": {"$ref": "#/$defs/id"},
    "authorityId": {"$ref": "#/$defs/id"},
    "registryId": {"$ref": "#/$defs/id"},
    "backendConfigSha256": {"$ref": "#/$defs/sha256"},
    "backendProtocol": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["major", "minor"], "properties": {"major": {"type": "integer", "minimum": 1, "maximum": 65535}, "minor": {"type": "integer", "minimum": 0, "maximum": 65535}}}]},
    "capabilityManifestSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "finalFencingToken": {"const": 2},
    "finalGrantSha256": {"$ref": "#/$defs/sha256"},
    "checks": {
      "type": "array", "minItems": 6, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "passed", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "passed": {"const": true},
          "evidence": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
