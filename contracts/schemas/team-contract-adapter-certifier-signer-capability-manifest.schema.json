{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-certifier-signer-capability-manifest.schema.json",
  "title": "Adapter certifier signer capability manifest", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "signerId", "certifierId", "implementationId", "protocolMajor", "protocolMinor", "capabilities", "keyIds"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCertifierSignerCapabilityManifest"}, "requestId": {"$ref": "#/$defs/id"}, "signerId": {"$ref": "#/$defs/id"}, "certifierId": {"$ref": "#/$defs/id"}, "implementationId": {"$ref": "#/$defs/id"}, "protocolMajor": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocolMinor": {"type": "integer", "minimum": 0, "maximum": 65535}, "capabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}}, "keyIds": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
