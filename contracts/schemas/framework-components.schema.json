{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.local/schemas/framework-components.schema.json",
  "title": "PocoDDSRuntime framework component ownership and CI impact catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "product", "globalPaths", "components"],
  "properties": {
    "$schema": {"type":"string","minLength":1},
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeFrameworkComponents"},
    "globalPaths": {"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
    "components": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["id","owner","paths","requires","buildTargets","testLabels"],
        "properties": {
          "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
          "owner":{"type":"string","pattern":"^team/[a-z0-9][a-z0-9-]*$"},
          "paths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
          "requires":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"}},
          "buildTargets":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "testLabels":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"}}
        }
      }
    }
  },
  "$defs": {
    "path":{"type":"string","minLength":1,"pattern":"^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
