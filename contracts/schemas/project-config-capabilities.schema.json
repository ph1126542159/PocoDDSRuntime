{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/project-config-capabilities.schema.json",
  "title": "PocoDDSRuntime project configuration transaction capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "participants"],
  "properties": {
    "schemaVersion": {"const": 1},
    "participants": {
      "type": "array",
      "items": {"$ref": "#/$defs/participant"}
    }
  },
  "$defs": {
    "participantId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownedPaths", "mode"],
      "properties": {
        "id": {"$ref": "#/$defs/participantId"},
        "ownedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/jsonPointer"}
        },
        "mode": {"enum": ["hot-reload", "restart", "immutable"]},
        "after": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/participantId"}
        },
        "timeoutSeconds": {"type": "number", "minimum": 0.1, "maximum": 300},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [{
        "if": {"properties": {"mode": {"const": "hot-reload"}}, "required": ["mode"]},
        "then": {"required": ["command"]}
      }]
    }
  }
}
