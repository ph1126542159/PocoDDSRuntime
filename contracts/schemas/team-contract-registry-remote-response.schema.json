{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-remote-response.schema.json",
  "title": "Remote team contract Registry command result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "requestSha256", "operation", "passed", "registryId", "revision", "stateSha256", "report", "files", "error"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryRemoteResponse"},
    "requestId": {"$ref": "#/$defs/id"},
    "requestSha256": {"$ref": "#/$defs/sha256"},
    "operation": {"enum": ["publish", "promote", "rollback", "verify", "resolve"]},
    "passed": {"type": "boolean"},
    "registryId": {"$ref": "#/$defs/id"},
    "revision": {"type": ["integer", "null"], "minimum": 0},
    "stateSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "report": {"type": ["object", "null"]},
    "files": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "dataBase64"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "dataBase64": {"type": "string"}
        }
      }
    },
    "error": {"type": ["string", "null"], "maxLength": 1024}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
