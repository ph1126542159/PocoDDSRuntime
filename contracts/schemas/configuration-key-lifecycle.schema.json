{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/configuration-key-lifecycle.schema.json",
  "title": "Bundle-local configuration key deprecation and migration lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "entries": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "participantId", "operation", "sourceKey", "replacementKey",
        "deprecatedSince", "removalAllowedFrom"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PDR-CFG-[0-9]{4,}$"
        },
        "participantId": {
          "$ref": "configuration-participants.schema.json#/$defs/participantId"
        },
        "operation": { "enum": ["rename", "remove"] },
        "sourceKey": {
          "$ref": "configuration-participants.schema.json#/$defs/prefix"
        },
        "replacementKey": {
          "oneOf": [
            { "$ref": "configuration-participants.schema.json#/$defs/prefix" },
            { "type": "null" }
          ]
        },
        "deprecatedSince": { "$ref": "#/$defs/semver" },
        "removalAllowedFrom": { "$ref": "#/$defs/semver" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "rename" } },
            "required": ["operation"]
          },
          "then": { "properties": { "replacementKey": { "type": "string" } } },
          "else": { "properties": { "replacementKey": { "type": "null" } } }
        }
      ]
    }
  }
}
