{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-current.schema.json",
  "title": "Current atomically selected Adapter Catalog", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "catalogId", "generation", "catalogGeneration", "catalogSha256", "stateSha256", "action", "operationId", "actor", "occurredAt", "adapters"],
  "properties": {
    "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogCurrent"},
    "catalogId": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1}, "catalogGeneration": {"type": "integer", "minimum": 1},
    "catalogSha256": {"$ref": "#/$defs/sha256"}, "stateSha256": {"$ref": "#/$defs/sha256"}, "action": {"enum": ["activate", "rollback"]},
    "operationId": {"$ref": "#/$defs/id"}, "actor": {"$ref": "#/$defs/id"}, "occurredAt": {"type": "string", "format": "date-time"},
    "adapters": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/adapter"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["adapterId", "adapterType", "manifestId", "revision", "owner", "protocolId", "configSha256"], "properties": {"adapterId": {"$ref": "#/$defs/id"}, "adapterType": {"$ref": "#/$defs/type"}, "manifestId": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}, "owner": {"type": "string", "minLength": 3}, "protocolId": {"$ref": "#/$defs/id"}, "configSha256": {"$ref": "#/$defs/sha256"}}}
  }
}
