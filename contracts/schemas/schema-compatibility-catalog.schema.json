{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pocodds.dev/schemas/schema-compatibility-catalog.schema.json",
  "title": "PocoDDS Schema Compatibility Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseline", "candidate"],
        "properties": {
          "baseline": {"type": "string", "minLength": 1},
          "candidate": {"type": "string", "minLength": 1},
          "mode": {"enum": ["none", "backward", "forward", "full"]}
        }
      }
    }
  }
}
