{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-reconciler-config.schema.json",
  "title": "Pinned Adapter Catalog lifecycle Reconciler config", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "reconcilerId", "kind", "protocolMajor", "minimumProtocolMinor", "requiredCapabilities", "executable", "executableSha256", "arguments", "artifactPins", "environmentVariables", "optionalEnvironmentVariables", "timeoutSeconds", "maxResponseBytes", "healthAttempts", "healthIntervalMilliseconds"],
  "properties": {
    "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogReconcilerConfig"}, "reconcilerId": {"$ref": "#/$defs/id"}, "kind": {"const": "external-command"},
    "protocolMajor": {"type": "integer", "minimum": 1, "maximum": 65535}, "minimumProtocolMinor": {"type": "integer", "minimum": 0, "maximum": 65535},
    "requiredCapabilities": {"const": ["abort", "activate", "bounded-drain", "commit", "health-gate", "idempotent-operations", "prepare", "rollback"]},
    "executable": {"type": "string", "minLength": 1}, "executableSha256": {"$ref": "#/$defs/sha256"},
    "arguments": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "artifactPins": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "environmentVariables": {"$ref": "#/$defs/environmentList"}, "optionalEnvironmentVariables": {"$ref": "#/$defs/environmentList"},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60}, "maxResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
    "healthAttempts": {"type": "integer", "minimum": 1, "maximum": 100}, "healthIntervalMilliseconds": {"type": "integer", "minimum": 0, "maximum": 30000}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "environmentList": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}}}
}
