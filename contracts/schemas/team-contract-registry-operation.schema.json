{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-operation.schema.json",
  "title": "Team contract Registry mutation or verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "product", "operation", "passed", "registry", "registryId",
    "revision", "stateSha256", "packageSha256", "lockSha256", "channel", "generation"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryOperation"},
    "operation": {"enum": ["init", "publish", "promote", "rollback", "verify"]},
    "passed": {"const": true},
    "registry": {"type": "string", "minLength": 1},
    "registryId": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 0},
    "stateSha256": {"$ref": "#/$defs/sha256"},
    "packageSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "lockSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "channel": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "generation": {"type": ["integer", "null"], "minimum": 0}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
