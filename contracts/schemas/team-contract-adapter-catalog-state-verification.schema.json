{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-state-verification.schema.json",
  "title": "Adapter Catalog immutable state-chain verification", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "passed", "catalogId", "generation", "stateSha256", "catalogGeneration", "catalogSha256", "stateCount", "catalogBlobCount", "adapterCount", "verifiedAt"],
  "properties": {
    "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogStateVerification"}, "passed": {"const": true},
    "catalogId": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1}, "stateSha256": {"$ref": "#/$defs/sha256"},
    "catalogGeneration": {"type": "integer", "minimum": 1}, "catalogSha256": {"$ref": "#/$defs/sha256"},
    "stateCount": {"type": "integer", "minimum": 1}, "catalogBlobCount": {"type": "integer", "minimum": 1}, "adapterCount": {"type": "integer", "minimum": 1, "maximum": 256},
    "verifiedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
