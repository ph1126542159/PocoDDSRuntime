{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-certifier-trust-migration-report.schema.json",
  "title": "Governed Adapter certifier trust pointer migration evidence",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "passed", "proposalId", "proposalSha256", "operationId", "controlId", "trustPolicyId", "sourceStateVersion", "targetStateVersion", "sourcePointerSha256", "sourceStateSha256", "policyGeneration", "policySha256", "stateBackendId", "artifactStoreId", "sourceStateBackendConfigSha256", "sourceArtifactStoreConfigSha256", "targetAdapterConfigResolverId", "targetStateBackendConfigRef", "targetArtifactStoreConfigRef", "governancePolicyId", "governancePolicySha256", "proposerId", "activatorId", "approvals", "migratedAt"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCertifierTrustStateMigrationReport"}, "passed": {"const": true}, "proposalId": {"$ref": "#/$defs/id"}, "proposalSha256": {"$ref": "#/$defs/sha256"}, "operationId": {"$ref": "#/$defs/id"},
    "controlId": {"$ref": "#/$defs/id"}, "trustPolicyId": {"$ref": "#/$defs/id"}, "sourceStateVersion": {"type": "integer", "minimum": 1, "maximum": 99999}, "targetStateVersion": {"type": "integer", "minimum": 2, "maximum": 100000}, "sourcePointerSha256": {"$ref": "#/$defs/sha256"}, "sourceStateSha256": {"$ref": "#/$defs/sha256"}, "policyGeneration": {"type": "integer", "minimum": 1}, "policySha256": {"$ref": "#/$defs/sha256"},
    "stateBackendId": {"$ref": "#/$defs/id"}, "artifactStoreId": {"$ref": "#/$defs/id"}, "sourceStateBackendConfigSha256": {"$ref": "#/$defs/sha256"}, "sourceArtifactStoreConfigSha256": {"$ref": "#/$defs/sha256"}, "targetAdapterConfigResolverId": {"$ref": "#/$defs/id"}, "targetStateBackendConfigRef": {"allOf": [{"$ref": "#/$defs/adapterConfigRef"}, {"properties": {"adapterKind": {"const": "registry-leader-backend"}}}]}, "targetArtifactStoreConfigRef": {"allOf": [{"$ref": "#/$defs/adapterConfigRef"}, {"properties": {"adapterKind": {"const": "artifact-store"}}}]},
    "governancePolicyId": {"$ref": "#/$defs/id"}, "governancePolicySha256": {"$ref": "#/$defs/sha256"}, "proposerId": {"$ref": "#/$defs/id"}, "activatorId": {"$ref": "#/$defs/id"}, "approvals": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["approverId", "keyId", "approvalSha256"], "properties": {"approverId": {"$ref": "#/$defs/id"}, "keyId": {"$ref": "#/$defs/id"}, "approvalSha256": {"$ref": "#/$defs/sha256"}}}}, "migratedAt": {"type": "string", "format": "date-time"}, "signerReadmissionEvidenceSha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [{"if": {"properties": {"schemaVersion": {"const": 2}}}, "then": {"required": ["signerReadmissionEvidenceSha256"]}, "else": {"not": {"required": ["signerReadmissionEvidenceSha256"]}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "adapterConfigRef": {"type": "object", "additionalProperties": false, "required": ["kind", "resolverId", "configId", "adapterKind", "adapterId", "revision"], "properties": {"kind": {"const": "adapter-config-ref"}, "resolverId": {"$ref": "#/$defs/id"}, "configId": {"$ref": "#/$defs/id"}, "adapterKind": {"enum": ["artifact-store", "registry-leader-backend"]}, "adapterId": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}}}}
}
