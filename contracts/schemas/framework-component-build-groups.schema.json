{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.local/schemas/framework-component-build-groups.schema.json",
  "title": "Configured independently buildable framework component groups",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "profile", "groups"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "framework-component-build-groups"},
    "profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "target", "members"],
        "properties": {
          "component": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "target": {"type": "string", "minLength": 1},
          "members": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
