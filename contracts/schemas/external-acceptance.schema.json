{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/contracts/external-acceptance.schema.json",
  "title": "PocoDDSRuntime external acceptance evidence",
  "type": "object",
  "required": ["schemaVersion", "operation", "acceptanceType", "candidate", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": { "enum": ["external-acceptance-template", "external-acceptance"] },
    "acceptanceType": {
      "enum": ["petalinux-target", "physical-protocols", "production-identity",
               "site-network", "soak-24h", "soak-72h", "project-sil", "project-hil",
               "project-soak"]
    },
    "candidate": {
      "type": "object",
      "required": ["version", "gitCommit", "artifactManifestSha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "gitCommit": { "type": "string", "minLength": 1 },
        "artifactManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requirements": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "checks": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
