{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog.schema.json",
  "title": "Host-local Team Contract Adapter catalog", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "catalogId", "generation", "entries"],
  "properties": {
    "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalog"}, "catalogId": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1},
    "entries": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["adapterId", "adapterType", "manifestId", "revision", "manifestPath", "manifestSha256"], "properties": {"adapterId": {"$ref": "#/$defs/id"}, "adapterType": {"$ref": "#/$defs/type"}, "manifestId": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}, "manifestPath": {"type": "string", "minLength": 1}, "manifestSha256": {"$ref": "#/$defs/sha256"}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
