{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-artifact-store-capability-manifest.schema.json",
  "title": "Artifact Store capability manifest", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "storeId", "implementationId", "protocolMajor", "protocolMinor", "capabilities"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractArtifactStoreCapabilityManifest"}, "requestId": {"$ref": "#/$defs/id"}, "storeId": {"$ref": "#/$defs/id"}, "implementationId": {"$ref": "#/$defs/id"}, "protocolMajor": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocolMinor": {"type": "integer", "minimum": 0, "maximum": 65535}, "capabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
