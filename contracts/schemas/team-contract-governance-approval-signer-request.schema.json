{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-governance-approval-signer-request.schema.json",
  "title": "Governance Approval Signer request", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "signerId", "approverId", "operation", "purpose", "keyId", "algorithm", "payloadBase64", "payloadSha256"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractGovernanceApprovalSignerRequest"}, "requestId": {"$ref": "#/$defs/id"}, "signerId": {"$ref": "#/$defs/id"}, "approverId": {"$ref": "#/$defs/id"}, "operation": {"const": "sign"}, "purpose": {"enum": ["governance-approval", "adapter-certifier-trust-approval", "adapter-certifier-trust-migration-approval"]}, "keyId": {"$ref": "#/$defs/id"}, "algorithm": {"const": "Ed25519"}, "payloadBase64": {"type": "string", "minLength": 1, "maxLength": 87384}, "payloadSha256": {"$ref": "#/$defs/sha256"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
