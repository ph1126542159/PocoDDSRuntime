{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-standby-report.schema.json",
  "title": "Team Contract Registry standby operation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "passed", "operation", "standbyId", "registryId", "revision", "stateSha256", "syncGeneration", "sourceRecoveryPointSha256", "completedAt", "operator", "destination", "previousStandby"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryStandbyReport"},
    "passed": {"const": true},
    "operation": {"enum": ["init", "sync"]},
    "standbyId": {"$ref": "#/$defs/id"},
    "registryId": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 0},
    "stateSha256": {"$ref": "#/$defs/sha256"},
    "syncGeneration": {"type": "integer", "minimum": 1},
    "sourceRecoveryPointSha256": {"$ref": "#/$defs/sha256"},
    "completedAt": {"type": "string", "format": "date-time"},
    "operator": {"$ref": "#/$defs/id"},
    "destination": {"type": "string", "minLength": 1},
    "previousStandby": {"type": ["string", "null"]},
    "previousRevision": {"type": "integer", "minimum": 0},
    "previousStateSha256": {"$ref": "#/$defs/sha256"},
    "syncId": {"$ref": "#/$defs/id"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "sync"}}},
      "then": {"required": ["previousRevision", "previousStateSha256", "syncId"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
