{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-remote-audit-policy.schema.json",
  "title": "Independent signers trusted to checkpoint remote Registry request audits",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "policyId", "auditors", "revokedKeys"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryRemoteAuditPolicy"},
    "policyId": {"$ref": "#/$defs/id"},
    "auditors": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["auditorId", "keyId", "algorithm", "publicKey", "publicKeySha256", "registryIds", "notBefore", "notAfter"],
        "properties": {
          "auditorId": {"$ref": "#/$defs/id"},
          "keyId": {"$ref": "#/$defs/id"},
          "algorithm": {"const": "Ed25519"},
          "publicKey": {"type": "string", "pattern": "^keys/[A-Za-z0-9._-]+\\.pem$"},
          "publicKeySha256": {"$ref": "#/$defs/sha256"},
          "registryIds": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "notBefore": {"type": "string", "format": "date-time"},
          "notAfter": {"type": "string", "format": "date-time"}
        }
      }
    },
    "revokedKeys": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyId", "revokedAt", "reason"],
        "properties": {
          "keyId": {"$ref": "#/$defs/id"},
          "revokedAt": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
