{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-access-policy-v2.schema.json",
  "title": "Signed successor revision for remote Registry access and capacity policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "policyId", "registryId", "policyRevision", "previousPolicySha256", "issuedAt", "maxRequestBytes", "maxResponseBytes", "controlLimits", "principals", "revokedTokenSha256", "signer"],
  "properties": {
    "schemaVersion": {"const": 2},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryAccessPolicy"},
    "policyId": {"$ref": "#/$defs/id"},
    "registryId": {"$ref": "#/$defs/id"},
    "policyRevision": {"type": "integer", "minimum": 1},
    "previousPolicySha256": {"$ref": "#/$defs/sha256"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "maxRequestBytes": {"type": "integer", "minimum": 4096, "maximum": 67108864},
    "maxResponseBytes": {"type": "integer", "minimum": 4096, "maximum": 67108864},
    "controlLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxActiveRequestRecords", "maxRecoveryRecords", "maxAuditRecords", "maxControlBytes"],
      "properties": {
        "maxActiveRequestRecords": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxRecoveryRecords": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxAuditRecords": {"type": "integer", "minimum": 2, "maximum": 10000000},
        "maxControlBytes": {"type": "integer", "minimum": 1048576, "maximum": 1099511627776}
      }
    },
    "principals": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/principal"}
    },
    "revokedTokenSha256": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "signer": {
      "type": "object", "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": {"$ref": "#/$defs/id"},
        "algorithm": {"const": "Ed25519"},
        "signature": {"type": "string", "minLength": 88, "maxLength": 88}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "principal": {
      "type": "object", "additionalProperties": false,
      "required": ["principalId", "tokenSha256", "roles", "packageIds", "channels", "notBefore", "notAfter"],
      "properties": {
        "principalId": {"$ref": "#/$defs/id"},
        "tokenSha256": {"$ref": "#/$defs/sha256"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["reader", "publisher", "promoter", "rollback", "auditor", "operator"]}},
        "packageIds": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "channels": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "notBefore": {"type": "string", "format": "date-time"},
        "notAfter": {"type": "string", "format": "date-time"}
      }
    }
  }
}
