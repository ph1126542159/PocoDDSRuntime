{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.local/schemas/release-trust-policy.schema.json",
  "title": "PocoDDSRuntime Release Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "policyId", "allowedKeys", "revokedKeys"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "PocoDDSRuntime" },
    "policyId": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
    "allowedKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm"],
        "properties": {
          "keyId": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
          "algorithm": { "enum": ["Ed25519", "HMAC-SHA256"] },
          "publicKeySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "notBefore": { "type": "string", "format": "date-time" },
          "notAfter": { "type": "string", "format": "date-time" }
        },
        "allOf": [
          {
            "if": { "properties": { "algorithm": { "const": "Ed25519" } } },
            "then": { "required": ["publicKeySha256"] }
          }
        ]
      }
    },
    "revokedKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "revokedAt", "reason"],
        "properties": {
          "keyId": { "type": "string", "minLength": 1 },
          "revokedAt": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
