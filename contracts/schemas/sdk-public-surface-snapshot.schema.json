{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.dev/contracts/sdk-public-surface-snapshot.schema.json",
  "title": "PocoDDSRuntime installed SDK public surface snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "runtimeVersion",
    "surfaceSha256",
    "publicHeaders",
    "cmakeLibraryTargets",
    "binaryAbi"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": { "const": "sdk-public-surface-snapshot" },
    "runtimeVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "surfaceSha256": { "$ref": "#/$defs/sha256" },
    "publicHeaders": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^include/PocoDDS/.+\\.(h|hh|hpp|hxx)$" },
      "additionalProperties": { "$ref": "#/$defs/header" }
    },
    "cmakeLibraryTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^PocoDDS::\\S+$" }
    },
    "binaryAbi": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/binaryAbi" }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenSha256", "tokenCount"],
      "properties": {
        "tokenSha256": { "$ref": "#/$defs/sha256" },
        "tokenCount": { "type": "integer", "minimum": 1 }
      }
    },
    "binaryAbi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "artifacts"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/abiArtifact" }
        }
      }
    },
    "abiArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbolSha256", "symbolCount"],
      "properties": {
        "symbolSha256": { "$ref": "#/$defs/sha256" },
        "symbolCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
