{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-certifier-trust-state.schema.json",
  "title": "Immutable Adapter certifier trust remote state",
  "oneOf": [
    {"$ref": "#/$defs/stateV1"},
    {"$ref": "#/$defs/stateV2Migration"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["kind", "storeId", "namespaceId", "sha256", "sizeBytes", "mediaType"], "properties": {"kind": {"const": "content-addressed"}, "storeId": {"$ref": "#/$defs/id"}, "namespaceId": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha256"}, "sizeBytes": {"type": "integer", "minimum": 1}, "mediaType": {"type": "string"}}},
    "stateV1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "product", "controlId", "trustPolicyId", "stateVersion", "previousStateSha256", "action", "operationId", "actor", "mode", "policyGeneration", "policyRef", "policySha256", "activationRef", "activationSha256", "occurredAt"],
      "properties": {
        "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCertifierTrustState"}, "controlId": {"$ref": "#/$defs/id"}, "trustPolicyId": {"$ref": "#/$defs/id"},
        "stateVersion": {"type": "integer", "minimum": 1, "maximum": 100000}, "previousStateSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "action": {"enum": ["initialize", "activate"]}, "operationId": {"$ref": "#/$defs/id"}, "actor": {"$ref": "#/$defs/id"}, "mode": {"enum": ["initialize", "standard", "emergency-revocation"]},
        "policyGeneration": {"type": "integer", "minimum": 1}, "policyRef": {"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"mediaType": {"const": "application/vnd.pocodds.adapter-certifier-trust-policy+json"}}}]}, "policySha256": {"$ref": "#/$defs/sha256"}, "activationRef": {"oneOf": [{"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"mediaType": {"const": "application/vnd.pocodds.adapter-certifier-trust-activation+json"}}}]}, {"type": "null"}]}, "activationSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "occurredAt": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {"if": {"properties": {"stateVersion": {"const": 1}}}, "then": {"properties": {"previousStateSha256": {"type": "null"}, "action": {"const": "initialize"}, "mode": {"const": "initialize"}, "activationRef": {"type": "null"}, "activationSha256": {"type": "null"}}}},
        {"if": {"properties": {"stateVersion": {"minimum": 2}}}, "then": {"properties": {"previousStateSha256": {"$ref": "#/$defs/sha256"}, "action": {"const": "activate"}, "mode": {"enum": ["standard", "emergency-revocation"]}, "activationRef": {"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"mediaType": {"const": "application/vnd.pocodds.adapter-certifier-trust-activation+json"}}}]}, "activationSha256": {"$ref": "#/$defs/sha256"}}}}
      ]
    },
    "stateV2Migration": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "product", "controlId", "trustPolicyId", "stateVersion", "previousStateSha256", "action", "operationId", "actor", "mode", "policyGeneration", "policyRef", "policySha256", "migrationRef", "migrationSha256", "occurredAt"],
      "properties": {
        "schemaVersion": {"const": 2}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCertifierTrustState"}, "controlId": {"$ref": "#/$defs/id"}, "trustPolicyId": {"$ref": "#/$defs/id"},
        "stateVersion": {"type": "integer", "minimum": 2, "maximum": 100000}, "previousStateSha256": {"$ref": "#/$defs/sha256"}, "action": {"const": "migrate"}, "operationId": {"$ref": "#/$defs/id"}, "actor": {"$ref": "#/$defs/id"}, "mode": {"const": "portable-config-migration"},
        "policyGeneration": {"type": "integer", "minimum": 1}, "policyRef": {"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"mediaType": {"const": "application/vnd.pocodds.adapter-certifier-trust-policy+json"}}}]}, "policySha256": {"$ref": "#/$defs/sha256"}, "migrationRef": {"allOf": [{"$ref": "#/$defs/artifactRef"}, {"properties": {"mediaType": {"const": "application/vnd.pocodds.adapter-certifier-trust-migration+json"}}}]}, "migrationSha256": {"$ref": "#/$defs/sha256"}, "occurredAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
