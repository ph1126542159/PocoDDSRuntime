{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/project-config-plan.schema.json",
  "title": "PocoDDSRuntime project configuration transaction plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "transactionId", "createdAt", "project",
    "manifestSha256", "capabilities", "current", "candidate", "changes",
    "participants", "requiresRestart", "approval", "applicable", "rejectionReasons"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "project-config-plan"},
    "transactionId": {"type": "string", "format": "uuid"},
    "createdAt": {"type": "string", "format": "date-time"},
    "project": {"type": "string", "minLength": 1},
    "manifestSha256": {"$ref": "#/$defs/sha256"},
    "capabilities": {"$ref": "#/$defs/fileBinding"},
    "current": {"$ref": "#/$defs/configBinding"},
    "candidate": {"$ref": "#/$defs/configBinding"},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "participant", "mode"],
        "properties": {
          "path": {"type": "string", "pattern": "^/"},
          "kind": {"enum": ["added", "removed", "changed"]},
          "participant": {"type": "string"},
          "mode": {"enum": ["hot-reload", "restart", "immutable", "unowned"]}
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "order"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["hot-reload", "restart", "immutable"]},
          "order": {"type": "integer", "minimum": 0}
        }
      }
    },
    "requiresRestart": {"type": "boolean"},
    "approval": {"$ref": "#/$defs/approval"},
    "applicable": {"type": "boolean"},
    "rejectionReasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "configBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "documentSha256", "valuesSha256", "configVersion"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "documentSha256": {"$ref": "#/$defs/sha256"},
        "valuesSha256": {"$ref": "#/$defs/sha256"},
        "configVersion": {"type": "integer", "minimum": 1}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "policy", "rules"],
      "properties": {
        "required": {"type": "boolean"},
        "policy": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["path", "policyId", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "policyId": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          ]
        },
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/approvalRule"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}},
          "then": {
            "properties": {
              "policy": {"type": "object"},
              "rules": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"policy": {"type": "null"}}},
          "then": {
            "properties": {
              "required": {"const": false},
              "rules": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "approvalRule": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "changedPaths", "minimumApprovals", "requiredRoles",
        "separateInitiator"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "changedPaths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/"}
        },
        "minimumApprovals": {"type": "integer", "minimum": 1, "maximum": 16},
        "requiredRoles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "separateInitiator": {"type": "boolean"}
      }
    }
  }
}
