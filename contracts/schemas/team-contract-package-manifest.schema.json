{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-package-manifest.schema.json",
  "title": "Immutable cross-team contract package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "product", "packageId", "version", "owner",
    "sourceDateEpoch", "artifactSetSha256", "files"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractPackage"},
    "packageId": {"$ref": "#/$defs/packageId"},
    "version": {"$ref": "#/$defs/version"},
    "owner": {"$ref": "#/$defs/identifier"},
    "sourceDateEpoch": {"type": "integer", "minimum": 0},
    "artifactSetSha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "size", "sha256"],
        "properties": {
          "role": {"$ref": "#/$defs/role"},
          "path": {
            "type": "string",
            "pattern": "^contracts/(service-contract|participant-declaration|key-lifecycle|service-baseline|participant-baseline|key-lifecycle-baseline)/[0-9a-f]{64}\\.json$"
          },
          "size": {"type": "integer", "minimum": 2, "maximum": 16777216},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "packageId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {
      "enum": [
        "service-contract", "participant-declaration", "key-lifecycle",
        "service-baseline", "participant-baseline", "key-lifecycle-baseline"
      ]
    }
  }
}
