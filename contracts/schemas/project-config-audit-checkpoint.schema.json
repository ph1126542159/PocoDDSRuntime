{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/project-config-audit-checkpoint.schema.json",
  "title": "PocoDDSRuntime project configuration signed audit checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "product", "operation", "checkpointId", "createdAt",
    "actor", "project", "recordCount", "verifiedJournalCount", "lastSequence",
    "lastRecordSha256", "auditFileSha256", "headSha256", "checkpointSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeProjectConfigurationAuditCheckpoint"},
    "operation": {"const": "project-config-audit-checkpoint"},
    "checkpointId": {"type": "string", "format": "uuid"},
    "createdAt": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._@-]{0,127}$"},
    "project": {"type": "string", "minLength": 1},
    "recordCount": {"type": "integer", "minimum": 1},
    "verifiedJournalCount": {"type": "integer", "minimum": 1},
    "lastSequence": {"type": "integer", "minimum": 1},
    "lastRecordSha256": {"$ref": "#/$defs/sha256"},
    "auditFileSha256": {"$ref": "#/$defs/sha256"},
    "headSha256": {"$ref": "#/$defs/sha256"},
    "checkpointSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
