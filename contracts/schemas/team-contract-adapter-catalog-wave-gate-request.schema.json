{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-wave-gate-request.schema.json",
  "title": "Adapter Catalog Wave Gate evaluation request", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "gateId", "evaluationId", "rolloutId", "waveId", "waveIndex", "catalogId", "candidateCatalogGeneration", "candidateCatalogSha256", "attempt", "observationStartedAt", "nodeCounts"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogWaveGateRequest"}, "requestId": {"type": "string", "format": "uuid"}, "gateId": {"$ref": "#/$defs/id"}, "evaluationId": {"$ref": "#/$defs/id"}, "rolloutId": {"$ref": "#/$defs/pathId"}, "waveId": {"$ref": "#/$defs/pathId"}, "waveIndex": {"type": "integer", "minimum": 0, "maximum": 31}, "catalogId": {"$ref": "#/$defs/id"}, "candidateCatalogGeneration": {"type": "integer", "minimum": 2}, "candidateCatalogSha256": {"$ref": "#/$defs/sha256"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 100}, "observationStartedAt": {"type": "string", "format": "date-time"}, "nodeCounts": {"type": "object", "additionalProperties": false, "required": ["pending", "committed", "failed", "rolled-back"], "properties": {"pending": {"type": "integer", "minimum": 0}, "committed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "rolled-back": {"type": "integer", "minimum": 0}}}},
  "$defs": {"pathId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
