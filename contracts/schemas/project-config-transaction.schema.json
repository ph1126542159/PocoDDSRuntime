{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/project-config-transaction.schema.json",
  "title": "PocoDDSRuntime project configuration transaction journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "transactionId", "project", "status", "startedAt",
    "manifest", "manifestSha256", "plan", "planSha256", "capabilities",
    "capabilitiesSha256", "currentConfig", "candidateConfig", "previousConfig",
    "previousConfigSha256", "preflightCompleted", "commitAttempted", "commitCompleted",
    "rollbackCompleted", "events", "errors"
  ],
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"enum": [2, 3]}}},
      "then": {"required": ["journalSha256"]}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 3}}},
      "then": {"required": ["planSource", "candidateSource"]}
    }
  ],
  "dependentRequired": {
    "preflightEvidence": ["preflightEvidenceSha256"],
    "preflightEvidenceSha256": ["preflightEvidence"],
    "auditSequence": ["auditRecordSha256", "auditEvent"],
    "auditRecordSha256": ["auditSequence", "auditEvent"],
    "auditEvent": ["auditSequence", "auditRecordSha256"]
  },
  "properties": {
    "schemaVersion": {"enum": [1, 2, 3]},
    "operation": {"const": "project-config-transaction"},
    "transactionId": {"type": "string", "format": "uuid"},
    "project": {"type": "string", "minLength": 1},
    "initiatedBy": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._@-]{0,127}$"},
    "status": {
      "enum": [
        "preparing", "preflighting", "preflight-failed", "committing", "activating",
        "rolling-back", "rolled-back", "rollback-failed", "committed"
      ]
    },
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "recoveredAt": {"type": "string", "format": "date-time"},
    "manifest": {"type": "string", "minLength": 1},
    "manifestSha256": {"$ref": "#/$defs/sha256"},
    "plan": {"type": "string", "minLength": 1},
    "planSource": {"type": "string", "minLength": 1},
    "planSha256": {"$ref": "#/$defs/sha256"},
    "capabilities": {"type": "string", "minLength": 1},
    "capabilitiesSha256": {"$ref": "#/$defs/sha256"},
    "currentConfig": {"type": "string", "minLength": 1},
    "candidateConfig": {"type": "string", "minLength": 1},
    "candidateSource": {"type": "string", "minLength": 1},
    "previousConfig": {"type": "string", "minLength": 1},
    "previousConfigSha256": {"$ref": "#/$defs/sha256"},
    "activeConfigSha256": {"$ref": "#/$defs/sha256"},
    "preflightEvidence": {"type": "string", "minLength": 1},
    "preflightEvidenceSha256": {"$ref": "#/$defs/sha256"},
    "approval": {"$ref": "#/$defs/approvalEvidence"},
    "preflightCompleted": {"$ref": "#/$defs/participantIds"},
    "commitAttempted": {"$ref": "#/$defs/participantIds"},
    "commitCompleted": {"$ref": "#/$defs/participantIds"},
    "rollbackCompleted": {"$ref": "#/$defs/participantIds"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant", "phase", "status", "responseSha256", "finishedAt"],
        "properties": {
          "participant": {"type": "string", "minLength": 1},
          "phase": {"enum": ["preflight", "commit", "rollback"]},
          "status": {"enum": ["ready", "committed", "rolled-back"]},
          "responseSha256": {"$ref": "#/$defs/sha256"},
          "finishedAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "journalSha256": {"$ref": "#/$defs/sha256"},
    "auditSequence": {"type": "integer", "minimum": 1},
    "auditRecordSha256": {"$ref": "#/$defs/sha256"},
    "auditEvent": {
      "enum": [
        "CONFIG_TRANSACTION_COMMITTED", "CONFIG_TRANSACTION_ROLLED_BACK",
        "CONFIG_TRANSACTION_PREFLIGHT_FAILED", "CONFIG_TRANSACTION_ROLLBACK_FAILED",
        "CONFIG_TRANSACTION_RECOVERED_ROLLBACK"
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "participantIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "approvalEvidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "requestId", "requestFileSha256", "requestContentSha256", "ticket",
        "initiator", "policyId", "policySha256", "rules", "approvals", "verifiedAt"
      ],
      "properties": {
        "requestId": {"type": "string", "format": "uuid"},
        "requestFileSha256": {"$ref": "#/$defs/sha256"},
        "requestContentSha256": {"$ref": "#/$defs/sha256"},
        "ticket": {"type": "string", "minLength": 1},
        "initiator": {"type": "string", "minLength": 1},
        "policyId": {"type": "string", "minLength": 1},
        "policySha256": {"$ref": "#/$defs/sha256"},
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/approvalRule"}},
        "approvals": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["approverId", "keyId", "role", "signatureSha256"],
            "properties": {
              "approverId": {"type": "string", "minLength": 1},
              "keyId": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "signatureSha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "verifiedAt": {"type": "string", "format": "date-time"}
      }
    },
    "approvalRule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "changedPaths", "minimumApprovals", "requiredRoles", "separateInitiator"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "changedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "minimumApprovals": {"type": "integer", "minimum": 1, "maximum": 16},
        "requiredRoles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "separateInitiator": {"type": "boolean"}
      }
    }
  }
}
