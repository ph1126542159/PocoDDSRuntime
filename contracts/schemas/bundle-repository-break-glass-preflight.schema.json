{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.local/schemas/bundle-repository-break-glass-preflight.schema.json",
  "title": "PocoDDSRuntime Bundle Repository Break-Glass Preflight Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "product", "result", "checkedAt", "approvalId", "ticket",
    "requestSha256", "sourceStateSha256", "sourceDigest", "targetDigest",
    "fromSequence", "targetSequence", "targetBytes", "freeBytes", "requiredFreeBytes",
    "audit", "approvalCount", "minimumApprovals", "approvals", "trustPolicyId",
    "trustPolicySha256", "runtimeStoppedAcknowledged", "applyReady",
    "repositorySwitchPerformed", "highWaterChanged", "approvalConsumed",
    "temporaryStagingRemoved", "evidenceSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "PocoDDSBundleRepositoryBreakGlass" },
    "result": { "const": "BUNDLE_BREAK_GLASS_PREFLIGHT_PASS" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "approvalId": { "type": "string", "format": "uuid" },
    "ticket": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$" },
    "requestSha256": { "$ref": "#/$defs/sha256" },
    "sourceStateSha256": { "$ref": "#/$defs/sha256" },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "targetDigest": { "$ref": "#/$defs/sha256" },
    "fromSequence": { "type": "integer", "minimum": 2, "maximum": 9223372036854775807 },
    "targetSequence": { "type": "integer", "minimum": 1, "maximum": 9223372036854775806 },
    "targetBytes": { "type": "integer", "minimum": 0 },
    "freeBytes": { "type": "integer", "minimum": 0 },
    "requiredFreeBytes": { "type": "integer", "minimum": 1 },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["recordCount", "headSha256", "firstTimestamp", "lastTimestamp"],
      "properties": {
        "recordCount": { "type": "integer", "minimum": 0 },
        "headSha256": { "$ref": "#/$defs/sha256" },
        "firstTimestamp": { "type": ["string", "null"], "format": "date-time" },
        "lastTimestamp": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "approvalCount": { "type": "integer", "minimum": 1, "maximum": 16 },
    "minimumApprovals": { "type": "integer", "minimum": 1, "maximum": 16 },
    "approvals": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["approverId", "keyId", "signatureSha256"],
        "properties": {
          "approverId": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
          "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "signatureSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "trustPolicyId": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
    "trustPolicySha256": { "$ref": "#/$defs/sha256" },
    "runtimeStoppedAcknowledged": { "type": "boolean" },
    "applyReady": { "type": "boolean" },
    "repositorySwitchPerformed": { "const": false },
    "highWaterChanged": { "const": false },
    "approvalConsumed": { "const": false },
    "temporaryStagingRemoved": { "const": true },
    "evidenceSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
