{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-fleet-plan.schema.json",
  "title": "Canary and wave Adapter Catalog Fleet plan",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "rolloutId", "catalogId", "candidateCatalogGeneration", "candidateCatalogSha256", "maxParallelNodes", "waves"],
  "properties": {
    "schemaVersion": {"enum": [1, 2, 3, 4, 5, 6, 7]}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogFleetPlan"},
    "rolloutId": {"$ref": "#/$defs/pathId"}, "catalogId": {"$ref": "#/$defs/id"}, "candidateCatalogGeneration": {"type": "integer", "minimum": 2}, "candidateCatalogSha256": {"$ref": "#/$defs/sha256"},
    "executorConfigPath": {"type": "string", "minLength": 1}, "executorConfigSha256": {"$ref": "#/$defs/sha256"}, "gateConfigPath": {"type": "string", "minLength": 1}, "gateConfigSha256": {"$ref": "#/$defs/sha256"}, "controlAuthorizerConfigPath": {"type": "string", "minLength": 1}, "controlAuthorizerConfigSha256": {"$ref": "#/$defs/sha256"},
    "stateBackendId": {"$ref": "#/$defs/id"}, "stateBackendConfigSha256": {"$ref": "#/$defs/sha256"}, "artifactStoreId": {"$ref": "#/$defs/id"}, "artifactStoreConfigSha256": {"$ref": "#/$defs/sha256"},
    "adapterConfigResolverId": {"$ref": "#/$defs/id"}, "executorConfigRef": {"$ref": "#/$defs/adapterConfigRef"}, "gateConfigRef": {"$ref": "#/$defs/adapterConfigRef"}, "controlAuthorizerConfigRef": {"$ref": "#/$defs/adapterConfigRef"}, "stateBackendConfigRef": {"$ref": "#/$defs/adapterConfigRef"}, "artifactStoreConfigRef": {"$ref": "#/$defs/adapterConfigRef"},
    "adapterConformancePolicy": {"$ref": "#/$defs/admissionPolicy"}, "adapterConformanceTrustPolicy": {"$ref": "#/$defs/trustRequirement"}, "maxParallelNodes": {"type": "integer", "minimum": 1, "maximum": 16},
    "waves": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["waveId", "mode", "maxFailures", "nodes"], "properties": {"waveId": {"$ref": "#/$defs/pathId"}, "mode": {"enum": ["canary", "wave"]}, "maxFailures": {"type": "integer", "minimum": 0}, "gatePolicy": {"$ref": "#/$defs/gatePolicy"}, "nodes": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["nodeId", "failureDomain", "expectedActivationGeneration"], "properties": {"nodeId": {"$ref": "#/$defs/pathId"}, "failureDomain": {"$ref": "#/$defs/id"}, "expectedActivationGeneration": {"type": "integer", "minimum": 1}}}}}}}
  },
  "allOf": [
    {"if": {"properties": {"schemaVersion": {"const": 1}}}, "then": {"required": ["executorConfigPath", "executorConfigSha256"], "properties": {"waves": {"items": {"not": {"required": ["gatePolicy"]}}}}}},
    {"if": {"properties": {"schemaVersion": {"const": 2}}}, "then": {"required": ["executorConfigPath", "executorConfigSha256", "gateConfigPath", "gateConfigSha256"], "properties": {"waves": {"items": {"required": ["gatePolicy"]}}}}},
    {"if": {"properties": {"schemaVersion": {"const": 3}}}, "then": {"required": ["executorConfigPath", "executorConfigSha256", "gateConfigPath", "gateConfigSha256", "controlAuthorizerConfigPath", "controlAuthorizerConfigSha256"], "properties": {"waves": {"items": {"required": ["gatePolicy"]}}}}},
    {"if": {"properties": {"schemaVersion": {"const": 4}}}, "then": {"required": ["executorConfigPath", "executorConfigSha256", "gateConfigPath", "gateConfigSha256", "controlAuthorizerConfigPath", "controlAuthorizerConfigSha256", "stateBackendId", "stateBackendConfigSha256", "artifactStoreId", "artifactStoreConfigSha256"], "properties": {"waves": {"items": {"required": ["gatePolicy"]}}}}},
    {"if": {"properties": {"schemaVersion": {"const": 5}}}, "then": {"required": ["adapterConfigResolverId", "executorConfigRef", "gateConfigRef", "controlAuthorizerConfigRef", "stateBackendConfigRef", "artifactStoreConfigRef"], "not": {"required": ["adapterConformancePolicy"]}, "properties": {"waves": {"items": {"required": ["gatePolicy"]}}}}},
    {"if": {"properties": {"schemaVersion": {"const": 6}}}, "then": {"required": ["adapterConfigResolverId", "executorConfigRef", "gateConfigRef", "controlAuthorizerConfigRef", "stateBackendConfigRef", "artifactStoreConfigRef", "adapterConformancePolicy"], "not": {"required": ["adapterConformanceTrustPolicy"]}, "properties": {"waves": {"items": {"required": ["gatePolicy"]}}}}},
    {"if": {"properties": {"schemaVersion": {"const": 7}}}, "then": {"required": ["adapterConfigResolverId", "executorConfigRef", "gateConfigRef", "controlAuthorizerConfigRef", "stateBackendConfigRef", "artifactStoreConfigRef", "adapterConformancePolicy", "adapterConformanceTrustPolicy"], "properties": {"waves": {"items": {"required": ["gatePolicy"]}}}}}
  ],
  "$defs": {
    "pathId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapterConfigRef": {"type": "object", "additionalProperties": false, "required": ["kind", "resolverId", "configId", "adapterKind", "adapterId", "revision"], "properties": {"kind": {"const": "adapter-config-ref"}, "resolverId": {"$ref": "#/$defs/id"}, "configId": {"$ref": "#/$defs/id"}, "adapterKind": {"enum": ["artifact-store", "control-authorizer", "fleet-executor", "registry-leader-backend", "wave-gate"]}, "adapterId": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}}},
    "gatePolicy": {"type": "object", "additionalProperties": false, "required": ["minimumObservationSeconds", "maxEvaluations", "rejectionAction"], "properties": {"minimumObservationSeconds": {"type": "integer", "minimum": 0, "maximum": 86400}, "maxEvaluations": {"type": "integer", "minimum": 1, "maximum": 100}, "rejectionAction": {"enum": ["pause", "rollback"]}}},
    "admissionPolicy": {"type": "object", "additionalProperties": false, "required": ["policyId", "certificationLevel", "checkSetVersion", "maximumEvidenceAgeSeconds", "requiredAdapterKinds", "requiredChecks"], "properties": {"policyId": {"$ref": "#/$defs/id"}, "certificationLevel": {"const": "integration-readiness"}, "checkSetVersion": {"const": "1.0.0"}, "maximumEvidenceAgeSeconds": {"type": "integer", "minimum": 60, "maximum": 2678400}, "requiredAdapterKinds": {"const": ["adapter-config-resolver", "artifact-store", "control-authorizer", "fleet-executor", "registry-leader-backend", "wave-gate"]}, "requiredChecks": {"const": ["adapter-identity-bound", "artifact-pins-revalidated", "capability-negotiated", "capability-replay-stable", "config-pin-enforced", "config-revalidated", "environment-confined", "evidence-redacted", "process-policy-bounded"]}}},
    "trustRequirement": {"type": "object", "additionalProperties": false, "required": ["policyId", "minimumGeneration"], "properties": {"policyId": {"$ref": "#/$defs/id"}, "minimumGeneration": {"type": "integer", "minimum": 1, "maximum": 2147483647}}}
  }
}
