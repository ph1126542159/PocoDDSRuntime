{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-reconcile-status.schema.json",
  "title": "Adapter Catalog rollout journal status", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "transactionId", "reconcilerId", "catalogId", "status", "terminal", "sourceActivationGeneration", "candidateCatalogGeneration", "switchedGeneration", "rollbackGeneration", "healthAttempts", "errorCode", "journalSha256", "observedAt"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogReconcileStatus"}, "transactionId": {"$ref": "#/$defs/id"}, "reconcilerId": {"$ref": "#/$defs/id"}, "catalogId": {"$ref": "#/$defs/id"}, "status": {"type": "string", "minLength": 1, "maxLength": 64}, "terminal": {"type": "boolean"}, "sourceActivationGeneration": {"type": "integer", "minimum": 1}, "candidateCatalogGeneration": {"type": "integer", "minimum": 2}, "switchedGeneration": {"oneOf": [{"type": "integer", "minimum": 2}, {"type": "null"}]}, "rollbackGeneration": {"oneOf": [{"type": "integer", "minimum": 3}, {"type": "null"}]}, "healthAttempts": {"type": "integer", "minimum": 0, "maximum": 100}, "errorCode": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "journalSha256": {"$ref": "#/$defs/sha256"}, "observedAt": {"type": "string", "format": "date-time"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
