{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-conformance-trust-policy.schema.json",
  "title": "Adapter conformance certifier trust and revocation policy",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "policyId", "generation", "maximumAttestationLifetimeSeconds", "allowedCertifiers", "revokedKeys"],
  "properties": {
    "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterConformanceTrustPolicy"}, "policyId": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "maximumAttestationLifetimeSeconds": {"type": "integer", "minimum": 60, "maximum": 2678400},
    "allowedCertifiers": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["certifierId", "keyId", "algorithm", "publicKey", "publicKeySha256", "adapterKinds", "adapterIds", "notBefore", "notAfter"], "properties": {"certifierId": {"$ref": "#/$defs/id"}, "keyId": {"$ref": "#/$defs/id"}, "algorithm": {"const": "Ed25519"}, "publicKey": {"type": "string", "pattern": "^keys/[A-Za-z0-9._-]+\\.pem$"}, "publicKeySha256": {"$ref": "#/$defs/sha256"}, "adapterKinds": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["adapter-config-resolver", "artifact-store", "control-authorizer", "fleet-executor", "registry-leader-backend", "wave-gate"]}}, "adapterIds": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "notBefore": {"type": "string", "format": "date-time"}, "notAfter": {"type": "string", "format": "date-time"}}}},
    "revokedKeys": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["keyId", "revokedAt", "reason"], "properties": {"keyId": {"$ref": "#/$defs/id"}, "revokedAt": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1, "maxLength": 512}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
