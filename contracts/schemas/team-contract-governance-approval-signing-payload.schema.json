{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-governance-approval-signing-payload.schema.json",
  "title": "Governance approval external signer domain-separated payload",
  "oneOf": [
    {"$ref": "#/$defs/externalPayload"},
    {"$ref": "#/$defs/admittedPayload"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "externalPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "product", "purpose", "approvalProduct", "approverId", "keyId", "subjectSha256", "signerId", "signerConfigSha256", "signerCapabilityManifestSha256"],
      "properties": {
        "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractGovernanceApprovalSigningPayload"},
        "purpose": {"enum": ["governance-approval", "adapter-certifier-trust-approval", "adapter-certifier-trust-migration-approval"]},
        "approvalProduct": {"$ref": "#/$defs/id"}, "approverId": {"$ref": "#/$defs/id"}, "keyId": {"$ref": "#/$defs/id"}, "subjectSha256": {"$ref": "#/$defs/sha256"},
        "signerId": {"$ref": "#/$defs/id"}, "signerConfigSha256": {"$ref": "#/$defs/sha256"}, "signerCapabilityManifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "admittedPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "product", "purpose", "approvalProduct", "approverId", "keyId", "subjectSha256", "signerId", "signerConfigSha256", "signerCapabilityManifestSha256", "signerConformanceId", "signerConformanceEvidenceSha256", "signerConformanceAttestationSha256", "signerConformanceCertifierId", "signerConformanceCertifierKeyId", "signerConformanceTrustPolicyId", "signerConformanceTrustPolicyGeneration", "signerConformanceTrustPolicySha256"],
      "properties": {
        "schemaVersion": {"const": 2}, "product": {"const": "PocoDDSRuntimeTeamContractGovernanceApprovalSigningPayload"},
        "purpose": {"enum": ["governance-approval", "adapter-certifier-trust-approval", "adapter-certifier-trust-migration-approval"]},
        "approvalProduct": {"$ref": "#/$defs/id"}, "approverId": {"$ref": "#/$defs/id"}, "keyId": {"$ref": "#/$defs/id"}, "subjectSha256": {"$ref": "#/$defs/sha256"},
        "signerId": {"$ref": "#/$defs/id"}, "signerConfigSha256": {"$ref": "#/$defs/sha256"}, "signerCapabilityManifestSha256": {"$ref": "#/$defs/sha256"},
        "signerConformanceId": {"$ref": "#/$defs/sha256"}, "signerConformanceEvidenceSha256": {"$ref": "#/$defs/sha256"}, "signerConformanceAttestationSha256": {"$ref": "#/$defs/sha256"},
        "signerConformanceCertifierId": {"$ref": "#/$defs/id"}, "signerConformanceCertifierKeyId": {"$ref": "#/$defs/id"},
        "signerConformanceTrustPolicyId": {"$ref": "#/$defs/id"}, "signerConformanceTrustPolicyGeneration": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "signerConformanceTrustPolicySha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
