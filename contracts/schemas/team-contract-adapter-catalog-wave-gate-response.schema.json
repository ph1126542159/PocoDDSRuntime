{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-wave-gate-response.schema.json",
  "title": "Adapter Catalog Wave Gate evaluation response", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "gateId", "evaluationId", "rolloutId", "waveId", "attempt", "accepted", "decision", "evidenceSha256", "diagnosticCode"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogWaveGateResponse"}, "requestId": {"type": "string", "format": "uuid"}, "gateId": {"$ref": "#/$defs/id"}, "evaluationId": {"$ref": "#/$defs/id"}, "rolloutId": {"$ref": "#/$defs/pathId"}, "waveId": {"$ref": "#/$defs/pathId"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 100}, "accepted": {"type": "boolean"}, "decision": {"enum": ["pass", "pause", "fail"]}, "evidenceSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "diagnosticCode": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}},
  "$defs": {"pathId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
