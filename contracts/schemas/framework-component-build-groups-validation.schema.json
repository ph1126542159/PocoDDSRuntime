{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.local/schemas/framework-component-build-groups-validation.schema.json",
  "title": "Framework component build-group validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "profile", "passed", "componentCount",
    "groupCount", "memberTargetCount", "groups", "violations"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "framework-component-build-groups-validation"},
    "profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "passed": {"type": "boolean"},
    "componentCount": {"type": "integer", "minimum": 1},
    "groupCount": {"type": "integer", "minimum": 1},
    "memberTargetCount": {"type": "integer", "minimum": 1},
    "groups": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "component", "owner", "target", "members", "productionTargets", "passed"
        ],
        "properties": {
          "component": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "owner": {"type": "string", "pattern": "^team/[a-z0-9][a-z0-9-]*$"},
          "target": {"type": "string", "minLength": 1},
          "members": {"$ref": "#/$defs/targets"},
          "productionTargets": {"$ref": "#/$defs/targets"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "violations": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "targets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
