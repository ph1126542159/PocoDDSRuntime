{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-reconciler-capability-manifest.schema.json",
  "title": "Adapter Catalog Reconciler capability manifest", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "reconcilerId", "implementationId", "protocolMajor", "protocolMinor", "capabilities"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogReconcilerCapabilityManifest"}, "requestId": {"type": "string", "format": "uuid"}, "reconcilerId": {"$ref": "#/$defs/id"}, "implementationId": {"$ref": "#/$defs/id"}, "protocolMajor": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocolMinor": {"type": "integer", "minimum": 0, "maximum": 65535}, "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "capability": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}}
}
