{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-impact-approval-policy.schema.json",
  "title": "Affected Consumer Owner approval trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "product", "policyId", "maxApprovalLifetimeSeconds",
    "allowedApprovers", "revokedKeys"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractImpactApprovalPolicy"},
    "policyId": {"$ref": "#/$defs/identifier"},
    "maxApprovalLifetimeSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "allowedApprovers": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "owner", "approverId", "keyId", "algorithm", "publicKey",
          "publicKeySha256", "notBefore", "notAfter"
        ],
        "properties": {
          "owner": {"$ref": "#/$defs/identifier"},
          "approverId": {"$ref": "#/$defs/identifier"},
          "keyId": {"$ref": "#/$defs/identifier"},
          "algorithm": {"const": "Ed25519"},
          "publicKey": {"type": "string", "pattern": "^keys/[A-Za-z0-9._-]+\\.pem$"},
          "publicKeySha256": {"$ref": "#/$defs/sha256"},
          "notBefore": {"type": "string", "format": "date-time"},
          "notAfter": {"type": "string", "format": "date-time"}
        }
      }
    },
    "revokedKeys": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["keyId", "revokedAt", "reason"],
        "properties": {
          "keyId": {"$ref": "#/$defs/identifier"},
          "revokedAt": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
