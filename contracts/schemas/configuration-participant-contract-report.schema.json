{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/configuration-participant-contract-report.schema.json",
  "title": "Configuration participant build-time contract evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "passed", "declarationCount", "participantCount",
    "compatible", "inputSetSha256", "inputs", "owners", "participants",
    "baseline", "violations", "errors"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "operation": { "type": "string", "const": "configuration-participant-contract" },
    "passed": { "type": "boolean" },
    "compatible": { "type": "boolean" },
    "declarationCount": { "type": "integer", "minimum": 0 },
    "participantCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "inputSetSha256": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "path", "sha256"],
        "properties": {
          "owner": { "type": "string", "minLength": 1, "maxLength": 192 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "owners": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 192 }
    },
    "participants": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "id", "serviceName", "ownedPrefixes", "after"],
        "properties": {
          "owner": { "type": "string", "minLength": 1, "maxLength": 192 },
          "id": { "$ref": "configuration-participants.schema.json#/$defs/participantId" },
          "serviceName": { "$ref": "configuration-participants.schema.json#/$defs/serviceName" },
          "ownedPrefixes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "configuration-participants.schema.json#/$defs/prefix" }
          },
          "after": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "configuration-participants.schema.json#/$defs/participantId" }
          }
        }
      }
    },
    "baseline": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "runtimeVersion", "participantCount"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "runtimeVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "participantCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            }
          }
        }
      ]
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "participantId", "detail"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "participantId": { "$ref": "configuration-participants.schema.json#/$defs/participantId" },
          "detail": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "detail"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "path": { "type": "string" },
          "detail": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "passed": { "const": true } }, "required": ["passed"] },
      "then": {
        "properties": {
          "inputSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "compatible": { "const": true },
          "errors": { "maxItems": 0 },
          "violations": { "maxItems": 0 }
        }
      },
      "else": {
        "anyOf": [
          { "properties": { "errors": { "minItems": 1 } } },
          { "properties": { "violations": { "minItems": 1 } } }
        ]
      }
    }
  ]
}
