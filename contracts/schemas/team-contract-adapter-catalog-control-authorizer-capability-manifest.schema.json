{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-control-authorizer-capability-manifest.schema.json",
  "title": "Adapter Catalog Control Authorizer capability manifest", "type": "object", "additionalProperties": false,
