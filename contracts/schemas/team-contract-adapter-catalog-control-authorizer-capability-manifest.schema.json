  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogControlAuthorizerCapabilityManifest"}, "requestId": {"type": "string", "format": "uuid"}, "authorizerId": {"$ref": "#/$defs/id"}, "implementationId": {"$ref": "#/$defs/id"}, "protocolMajor": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocolMinor": {"type": "integer", "minimum": 0, "maximum": 65535}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
