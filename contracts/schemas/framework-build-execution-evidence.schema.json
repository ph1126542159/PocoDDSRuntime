{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.local/schemas/framework-build-execution-evidence.schema.json",
  "title": "Input-bound framework CMake build execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "reportSha256", "profile", "sourceRevision",
    "sourceInputs", "sourceInputSetSha256", "buildInputs", "buildInputSetSha256",
    "selection", "configuration", "parallelism", "requestedTargets",
    "executedTargets", "command", "commandSha256", "cmakeVersion", "cacheKey",
    "passed", "evidenceSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "framework-build-execution-evidence"},
    "reportSha256": {"$ref": "#/$defs/sha256"},
    "profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{6,127}$"},
    "sourceInputs": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceInput"}
    },
    "sourceInputSetSha256": {"$ref": "#/$defs/sha256"},
    "buildInputs": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/buildInput"}
    },
    "buildInputSetSha256": {"$ref": "#/$defs/sha256"},
    "selection": {"enum": ["affected-targets", "full-build", "docs-only"]},
    "configuration": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"},
    "parallelism": {"type": "integer", "minimum": 1, "maximum": 256},
    "requestedTargets": {"$ref": "#/$defs/targets"},
    "executedTargets": {"$ref": "#/$defs/targets"},
    "command": {
      "type": "array", "uniqueItems": false,
      "items": {"type": "string", "minLength": 1}
    },
    "commandSha256": {"$ref": "#/$defs/sha256"},
    "cmakeVersion": {"type": "string", "pattern": "^cmake version .+$"},
    "cacheKey": {"type": "string", "pattern": "^pdr-[a-z0-9._-]+$"},
    "passed": {"const": true},
    "evidenceSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targets": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sourceInput": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "state", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "state": {"enum": ["file", "absent"]},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "buildInput": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "size", "sha256"],
      "properties": {
        "id": {"enum": [
          "cmake-cache", "target-graph", "component-build-groups",
          "dependency-inventory"
        ]},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
