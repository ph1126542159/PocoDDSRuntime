{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/configuration-participants.schema.json",
  "title": "Bundle-local transactional configuration participant declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "participants"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "participants": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/participant" }
    }
  },
  "$defs": {
    "participantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "serviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "serviceName", "ownedPrefixes", "after"],
      "properties": {
        "id": { "$ref": "#/$defs/participantId" },
        "serviceName": { "$ref": "#/$defs/serviceName" },
        "ownedPrefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/prefix" }
        },
        "after": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/participantId" }
        }
      }
    }
  }
}
