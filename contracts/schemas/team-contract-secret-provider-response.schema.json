{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-secret-provider-response.schema.json",
  "title": "Secret Provider response", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "providerId", "operation", "passed", "reference", "secretBase64", "error"],
  "properties": {"schemaVersion": {"enum": [1, 2]}, "product": {"const": "PocoDDSRuntimeTeamContractSecretProviderResponse"}, "requestId": {"$ref": "#/$defs/id"}, "providerId": {"$ref": "#/$defs/id"}, "operation": {"enum": ["resolve", "lease"]}, "passed": {"type": "boolean"}, "reference": {"$ref": "team-contract-secret-reference.schema.json"}, "secretBase64": {"type": ["string", "null"]}, "selectedVersion": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "leaseId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "issuedAt": {"type": ["string", "null"], "format": "date-time"}, "expiresAt": {"type": ["string", "null"], "format": "date-time"}, "error": {"type": ["string", "null"], "maxLength": 1024}},
  "allOf": [{"if": {"properties": {"schemaVersion": {"const": 2}}}, "then": {"properties": {"operation": {"const": "lease"}}, "required": ["selectedVersion", "leaseId", "issuedAt", "expiresAt"]}, "else": {"properties": {"operation": {"const": "resolve"}}, "not": {"anyOf": [{"required": ["selectedVersion"]}, {"required": ["leaseId"]}, {"required": ["issuedAt"]}, {"required": ["expiresAt"]}]}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
