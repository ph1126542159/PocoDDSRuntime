{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-certifier-signer-config.schema.json",
  "title": "External Adapter certifier signer configuration",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "signerId", "certifierId", "kind", "protocolMajor", "minimumProtocolMinor", "requiredCapabilities", "keys", "executable", "executableSha256", "arguments", "artifactPins", "environmentVariables", "optionalEnvironmentVariables", "timeoutSeconds", "maxResponseBytes", "maxPayloadBytes"],
  "properties": {
    "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCertifierSignerConfig"},
    "signerId": {"$ref": "#/$defs/id"}, "certifierId": {"$ref": "#/$defs/id"}, "kind": {"const": "external-command"},
    "protocolMajor": {"type": "integer", "minimum": 1, "maximum": 65535}, "minimumProtocolMinor": {"type": "integer", "minimum": 0, "maximum": 65535},
    "requiredCapabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
    "keys": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["keyId", "algorithm", "publicKey", "publicKeySha256"], "properties": {"keyId": {"$ref": "#/$defs/id"}, "algorithm": {"const": "Ed25519"}, "publicKey": {"type": "string", "minLength": 1, "maxLength": 4096}, "publicKeySha256": {"$ref": "#/$defs/sha256"}}}},
    "executable": {"type": "string", "minLength": 1, "maxLength": 4096}, "executableSha256": {"$ref": "#/$defs/sha256"},
    "arguments": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "artifactPins": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/artifactPin"}},
    "environmentVariables": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/environment"}},
    "optionalEnvironmentVariables": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/environment"}},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60}, "maxResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}, "maxPayloadBytes": {"type": "integer", "minimum": 256, "maximum": 65536}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "environment": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "artifactPin": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 4096}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
