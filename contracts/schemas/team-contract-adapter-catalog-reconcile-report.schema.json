{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-reconcile-report.schema.json",
  "title": "Adapter Catalog health-gated rollout report", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "passed", "transactionId", "reconcilerId", "catalogId", "status", "sourceActivationGeneration", "candidateCatalogGeneration", "candidateCatalogSha256", "switchedGeneration", "rollbackGeneration", "healthAttempts", "errorCode", "capabilityManifestSha256", "journalSha256", "reportedAt"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogReconcileReport"}, "passed": {"type": "boolean"}, "transactionId": {"$ref": "#/$defs/id"}, "reconcilerId": {"$ref": "#/$defs/id"}, "catalogId": {"$ref": "#/$defs/id"}, "status": {"enum": ["committed", "aborted", "abort-failed", "rolled-back", "rollback-failed"]}, "sourceActivationGeneration": {"type": "integer", "minimum": 1}, "candidateCatalogGeneration": {"type": "integer", "minimum": 2}, "candidateCatalogSha256": {"$ref": "#/$defs/sha256"}, "switchedGeneration": {"oneOf": [{"type": "integer", "minimum": 2}, {"type": "null"}]}, "rollbackGeneration": {"oneOf": [{"type": "integer", "minimum": 3}, {"type": "null"}]}, "healthAttempts": {"type": "integer", "minimum": 0, "maximum": 100}, "errorCode": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "capabilityManifestSha256": {"$ref": "#/$defs/sha256"}, "journalSha256": {"$ref": "#/$defs/sha256"}, "reportedAt": {"type": "string", "format": "date-time"}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
