{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-reconciler-response.schema.json",
  "title": "Adapter Catalog lifecycle operation response", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "transactionId", "reconcilerId", "operation", "accepted", "state", "pendingOperations", "diagnosticCode"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogReconcilerResponse"}, "requestId": {"type": "string", "format": "uuid"}, "transactionId": {"$ref": "#/$defs/id"}, "reconcilerId": {"$ref": "#/$defs/id"}, "operation": {"enum": ["prepare", "drain", "activate", "health", "commit", "abort", "rollback"]}, "accepted": {"type": "boolean"}, "state": {"type": "string", "minLength": 1, "maxLength": 64}, "pendingOperations": {"type": "integer", "minimum": 0}, "diagnosticCode": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}},
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
