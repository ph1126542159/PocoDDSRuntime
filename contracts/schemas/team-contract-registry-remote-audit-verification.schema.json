{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-remote-audit-verification.schema.json",
  "title": "Remote Registry request audit-chain verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "passed", "registryId", "sequence", "lastRecordSha256", "headSha256", "verifiedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryRemoteAuditVerification"},
    "passed": {"const": true},
    "registryId": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 0},
    "lastRecordSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "headSha256": {"$ref": "#/$defs/sha256"},
    "verifiedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
