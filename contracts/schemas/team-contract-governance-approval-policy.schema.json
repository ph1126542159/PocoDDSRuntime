{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-governance-approval-policy.schema.json",
  "title": "Portable M-of-N governance approval policy",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "policyId", "roles", "allowedApprovers", "executorIds", "revokedKeys"],
  "properties": {
    "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractGovernanceApprovalPolicy"}, "policyId": {"$ref": "#/$defs/id"},
    "roles": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["roleId", "minimumApprovals", "maxSubjectLifetimeSeconds"], "properties": {"roleId": {"$ref": "#/$defs/id"}, "minimumApprovals": {"type": "integer", "minimum": 1, "maximum": 64}, "maxSubjectLifetimeSeconds": {"type": "integer", "minimum": 60, "maximum": 86400}}}},
    "allowedApprovers": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["approverId", "keyId", "algorithm", "publicKeySha256", "roles"], "properties": {"approverId": {"$ref": "#/$defs/id"}, "keyId": {"$ref": "#/$defs/id"}, "algorithm": {"const": "Ed25519"}, "publicKeySha256": {"$ref": "#/$defs/sha256"}, "roles": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}},
    "executorIds": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "revokedKeys": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["keyId", "revokedAt", "reason"], "properties": {"keyId": {"$ref": "#/$defs/id"}, "revokedAt": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1, "maxLength": 512}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
