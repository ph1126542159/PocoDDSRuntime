{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/project-config-audit-checkpoint-verification.schema.json",
  "title": "PocoDDSRuntime project configuration audit checkpoint verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "verifiedAt", "checkpointId",
    "checkpointSha256", "project", "checkpointSequence", "currentSequence",
    "stateVerified", "keyId", "publicKeySha256", "signatureSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "operation": {"const": "project-config-audit-checkpoint-verify"},
    "verifiedAt": {"type": "string", "format": "date-time"},
    "checkpointId": {"type": "string", "format": "uuid"},
    "checkpointSha256": {"$ref": "#/$defs/sha256"},
    "project": {"type": "string", "minLength": 1},
    "checkpointSequence": {"type": "integer", "minimum": 1},
    "currentSequence": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "stateVerified": {"type": "boolean"},
    "keyId": {"type": "string", "minLength": 1},
    "publicKeySha256": {"$ref": "#/$defs/sha256"},
    "signatureSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
