{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.dev/contracts/repository-owners.schema.json",
  "title": "PocoDDSRuntime logical owner to repository reviewer mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "product", "defaultReviewers", "logicalOwners"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "product": { "const": "PocoDDSRuntimeRepositoryOwners" },
    "defaultReviewers": { "$ref": "#/$defs/reviewers" },
    "logicalOwners": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^team/[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/reviewers" }
    }
  },
  "$defs": {
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,38}[A-Za-z0-9])?(?:/[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?)?$"
      }
    }
  }
}
