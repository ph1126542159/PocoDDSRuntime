{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-package-lock.schema.json",
  "title": "Cross-team contract package lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "packages"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractPackageLock"},
    "trustPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "policySha256"],
      "properties": {
        "policyId": {"$ref": "#/$defs/identifier"},
        "policySha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageId", "version", "owner", "packageSha256", "manifestSha256",
          "artifactSetSha256", "files"
        ],
        "properties": {
          "packageId": {"$ref": "#/$defs/packageId"},
          "version": {"$ref": "#/$defs/version"},
          "owner": {"$ref": "#/$defs/identifier"},
          "packageSha256": {"$ref": "#/$defs/sha256"},
          "manifestSha256": {"$ref": "#/$defs/sha256"},
          "artifactSetSha256": {"$ref": "#/$defs/sha256"},
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keyId", "signatureSha256"],
            "properties": {
              "keyId": {"$ref": "#/$defs/identifier"},
              "signatureSha256": {"$ref": "#/$defs/sha256"},
              "publicKeySha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "sha256"],
              "properties": {
                "role": {"$ref": "#/$defs/role"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "packageId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {
      "enum": [
        "service-contract", "participant-declaration", "key-lifecycle",
        "service-baseline", "participant-baseline", "key-lifecycle-baseline"
      ]
    }
  }
}
