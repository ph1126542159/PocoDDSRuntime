{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-pointer.schema.json",
  "title": "Atomic pointer to the current immutable team contract Registry state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "registryId", "revision", "stateSha256", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryPointer"},
    "registryId": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 0},
    "stateSha256": {"$ref": "#/$defs/sha256"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
