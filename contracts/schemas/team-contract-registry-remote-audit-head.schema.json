{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-remote-audit-head.schema.json",
  "title": "Mutable pointer to an immutable remote Registry request audit chain",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "registryId", "sequence", "lastRecordSha256", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryRemoteAuditHead"},
    "registryId": {"$ref": "#/$defs/id"},
    "sequence": {"type": "integer", "minimum": 0},
    "lastRecordSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
