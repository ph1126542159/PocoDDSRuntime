{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-anchor-verification.schema.json",
  "title": "Proof that the current Registry still contains an externally anchored state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "product", "operation", "passed", "anchorId", "anchorSha256",
    "anchorServiceId", "registryId", "anchoredRevision", "currentRevision", "currentStateSha256",
    "policyId", "policySha256", "keyId", "publicKeySha256", "verifiedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryAnchorVerification"},
    "operation": {"const": "team-contract-registry-anchor-verify"},
    "passed": {"const": true},
    "anchorId": {"$ref": "#/$defs/id"},
    "anchorSha256": {"$ref": "#/$defs/sha256"},
    "anchorServiceId": {"$ref": "#/$defs/id"},
    "registryId": {"$ref": "#/$defs/id"},
    "anchoredRevision": {"type": "integer", "minimum": 0},
    "currentRevision": {"type": "integer", "minimum": 0},
    "currentStateSha256": {"$ref": "#/$defs/sha256"},
    "policyId": {"$ref": "#/$defs/id"},
    "policySha256": {"$ref": "#/$defs/sha256"},
    "keyId": {"$ref": "#/$defs/id"},
    "publicKeySha256": {"$ref": "#/$defs/sha256"},
    "verifiedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
