{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-anchor.schema.json",
  "title": "Externally stored signed anchor for a team contract Registry state revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "product", "operation", "anchorId", "anchorServiceId", "registryId",
    "registryRevision", "registryStateSha256", "previousAnchorSha256", "issuedAt", "keyId", "signature"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryAnchor"},
    "operation": {"const": "team-contract-registry-anchor"},
    "anchorId": {"$ref": "#/$defs/id"},
    "anchorServiceId": {"$ref": "#/$defs/id"},
    "registryId": {"$ref": "#/$defs/id"},
    "registryRevision": {"type": "integer", "minimum": 0},
    "registryStateSha256": {"$ref": "#/$defs/sha256"},
    "previousAnchorSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "issuedAt": {"type": "string", "format": "date-time"},
    "keyId": {"$ref": "#/$defs/id"},
    "signature": {"type": "string", "minLength": 88, "maxLength": 88}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
