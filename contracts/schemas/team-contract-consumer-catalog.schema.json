{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-consumer-catalog.schema.json",
  "title": "Cross-team contract consumer and required-test routing catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "consumers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractConsumerCatalog"},
    "consumers": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "dependencies", "requiredTestLabels"],
        "properties": {
          "id": {"$ref": "#/$defs/packageId"},
          "owner": {"$ref": "#/$defs/identifier"},
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["packageId", "roles"],
              "properties": {
                "packageId": {"$ref": "#/$defs/packageId"},
                "roles": {
                  "type": "array",
                  "maxItems": 6,
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/role"}
                }
              }
            }
          },
          "requiredTestLabels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"}
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "packageId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "role": {
      "enum": [
        "service-contract", "participant-declaration", "key-lifecycle",
        "service-baseline", "participant-baseline", "key-lifecycle-baseline"
      ]
    }
  }
}
