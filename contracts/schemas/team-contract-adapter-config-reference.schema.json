{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-config-reference.schema.json",
  "title": "Portable typed Adapter configuration reference",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "resolverId", "configId", "adapterKind", "adapterId", "revision"],
  "properties": {
    "kind": {"const": "adapter-config-ref"},
    "resolverId": {"$ref": "#/$defs/id"}, "configId": {"$ref": "#/$defs/id"},
    "adapterKind": {"enum": ["artifact-store", "control-authorizer", "fleet-executor", "registry-leader-backend", "wave-gate"]},
    "adapterId": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
