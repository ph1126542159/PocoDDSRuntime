    "^pdr\\.management\\.authentication\\.principals\\.[0-9]+\\.id$": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "^pdr\\.management\\.authentication\\.principals\\.[0-9]+\\.tokenEnvironment$": {
      "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "^pdr\\.management\\.authentication\\.principals\\.[0-9]+\\.tokenFile$": {
      "type": "string", "minLength": 1
    },
    "^pdr\\.management\\.authentication\\.principals\\.[0-9]+\\.permissions$": {
      "type": "string", "minLength": 1
    },
    "^pdr\\.alerts\\.webhook\\.[0-9]+\\.id$": {
      "type": "string", "minLength": 1
    },
    "^pdr\\.alerts\\.webhook\\.[0-9]+\\.enabled$": {
      "type": "boolean"
    },
    "^pdr\\.alerts\\.webhook\\.[0-9]+\\.url$": {
      "type": "string", "minLength": 1
    },
    "^pdr\\.alerts\\.webhook\\.[0-9]+\\.timeoutMilliseconds$": {
      "type": "integer", "minimum": 100, "maximum": 60000
    },
    "^pdr\\.alerts\\.webhook\\.[0-9]+\\.(initialBackoffMilliseconds|maximumBackoffMilliseconds)$": {
      "type": "integer", "minimum": 0, "maximum": 60000
    },
    "^pdr\\.alerts\\.webhook\\.[0-9]+\\.maximumAttempts$": {
      "type": "integer", "minimum": 1, "maximum": 10
    },
    "^pdr\\.alerts\\.webhook\\.[0-9]+\\.(authorizationEnvironment|privateKeyPasswordEnvironment)$": {
      "type": "string", "pattern": "^$|^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "^pdr\\.alerts\\.webhook\\.[0-9]+\\.(caCertificate|clientCertificate|privateKey)$": {
      "type": "string"
    },
    "^pdr\\.alerts\\.webhook\\.[0-9]+\\.insecureSkipVerify$": {
      "type": "boolean"
    },
    "^pdr\\.(simulation|modbus|serial|gnss|gpio|xbee|can|led)\\.count$": {
      "type": "integer", "minimum": 0, "maximum": 256
    },
    "^pdr\\.(simulation|modbus|serial|gnss|gpio|xbee|can|led)\\.[0-9]+\\.id$": {
      "type": "string", "minLength": 1
    },
    "^pdr\\.(simulation|modbus|serial|gnss|gpio|xbee|can|led)\\.[0-9]+\\.enabled$": {
      "type": "boolean"
    },
    "^pdr\\.(simulation|modbus|serial|gnss|gpio|xbee|can|led)\\.[0-9]+\\.required$": {
      "type": "boolean"
    },
    "^pdr\\.(mqtt|ros|udp)\\.count$": {
      "type": "integer", "minimum": 0, "maximum": 256
    },
    "^pdr\\.(mqtt|ros|udp)\\.[0-9]+\\.id$": {
      "type": "string", "minLength": 1
    },
    "^pdr\\.(mqtt|ros|udp)\\.[0-9]+\\.(enabled|required)$": {
      "type": "boolean"
    },
    "^pdr\\.modbus\\.[0-9]+\\.port$": {
      "type": "integer", "minimum": 1, "maximum": 65535
    },
    "^pdr\\.modbus\\.[0-9]+\\.unitId$": {
      "type": "integer", "minimum": 0, "maximum": 247
    },
    "^pdr\\.modbus\\.[0-9]+\\.timeoutMilliseconds$": {
      "type": "integer", "minimum": 1, "maximum": 60000
    },
    "^pdr\\.modbus\\.[0-9]+\\.retryDelayMilliseconds$": {
      "type": "integer", "minimum": 0, "maximum": 60000
    },
    "^pdr\\.modbus\\.[0-9]+\\.readRetryAttempts$": {
      "type": "integer", "minimum": 0, "maximum": 10
    },
    "^pdr\\.(serial|gnss|xbee)\\.[0-9]+\\.baudRate$": {
      "type": "integer", "minimum": 1, "maximum": 4000000
    },
    "^pdr\\.gnss\\.[0-9]+\\.transport$": {
      "type": "string", "enum": ["port", "loopback"]
    },
    "^pdr\\.gnss\\.[0-9]+\\.reconnectEnabled$": {
      "type": "boolean"
    },
    "^pdr\\.gnss\\.[0-9]+\\.reconnectDelayMilliseconds$": {
      "type": "integer", "minimum": 0, "maximum": 60000
    },
    "^pdr\\.gnss\\.[0-9]+\\.(readTimeoutMilliseconds|staleAfterMilliseconds)$": {
      "type": "integer", "minimum": 1, "maximum": 3600000
    },
    "^pdr\\.serial\\.[0-9]+\\.parameters$": {
      "type": "string", "pattern": "^[5-8][NEO][12]$"
    },
    "^pdr\\.serial\\.[0-9]+\\.transport$": {
      "type": "string", "enum": ["port", "loopback"]
    },
    "^pdr\\.serial\\.[0-9]+\\.flowControl$": {
      "type": "string", "enum": ["none", "rtscts"]
    },
    "^pdr\\.serial\\.[0-9]+\\.reconnectEnabled$": {
      "type": "boolean"
    },
    "^pdr\\.serial\\.[0-9]+\\.reconnectDelayMilliseconds$": {
      "type": "integer", "minimum": 0, "maximum": 60000
    },
    "^pdr\\.serial\\.[0-9]+\\.readTimeoutMilliseconds$": {
      "type": "integer", "minimum": 1, "maximum": 60000
    },
    "^pdr\\.gpio\\.[0-9]+\\.pin$": {
      "type": "integer", "minimum": 0
    },
    "^pdr\\.gpio\\.[0-9]+\\.direction$": {
      "type": "string", "enum": ["in", "out"]
    },
    "^pdr\\.gpio\\.[0-9]+\\.manageExport$": {
      "type": "boolean"
    },
    "^pdr\\.gpio\\.[0-9]+\\.exportTimeoutMilliseconds$": {
      "type": "integer", "minimum": 0, "maximum": 60000
    },
    "^pdr\\.xbee\\.[0-9]+\\.analogChannel$": {
      "type": "integer", "minimum": 0, "maximum": 15
    },
    "^pdr\\.xbee\\.[0-9]+\\.sourceAddress$": {
      "type": "string", "pattern": "^[0-9a-fA-F]{1,16}$"
    },
    "^pdr\\.xbee\\.[0-9]+\\.conversion$": {
      "type": "string", "enum": ["raw", "millivolts", "temperature", "humidity"]
    },
    "^pdr\\.xbee\\.[0-9]+\\.transport$": {
      "type": "string", "enum": ["port", "loopback"]
    },
    "^pdr\\.xbee\\.[0-9]+\\.reconnectEnabled$": {
      "type": "boolean"
    },
    "^pdr\\.xbee\\.[0-9]+\\.reconnectDelayMilliseconds$": {
      "type": "integer", "minimum": 0, "maximum": 60000
    },
    "^pdr\\.xbee\\.[0-9]+\\.(receiveTimeoutMilliseconds|staleAfterMilliseconds)$": {
      "type": "integer", "minimum": 1, "maximum": 3600000
    },
    "^pdr\\.can\\.[0-9]+\\.bitOffset$": {
      "type": "integer", "minimum": 0, "maximum": 511
    },
    "^pdr\\.can\\.[0-9]+\\.bitLength$": {
      "type": "integer", "minimum": 1, "maximum": 64
    },
    "^pdr\\.can\\.[0-9]+\\.transport$": {
      "type": "string", "enum": ["socketcan", "loopback"]
    },
    "^pdr\\.can\\.[0-9]+\\.frameId$": {
      "type": "string", "pattern": "^(0[xX][0-9a-fA-F]+|[0-9]+)$"
    },
    "^pdr\\.can\\.[0-9]+\\.(extended|reconnectEnabled)$": {
      "type": "boolean"
    },
    "^pdr\\.can\\.[0-9]+\\.reconnectDelayMilliseconds$": {
      "type": "integer", "minimum": 0, "maximum": 60000
    },
    "^pdr\\.can\\.[0-9]+\\.(receiveTimeoutMilliseconds|staleAfterMilliseconds)$": {
      "type": "integer", "minimum": 1, "maximum": 60000
    },
    "^pdr\\.(mqtt|ros|udp)\\.[0-9]+\\.(autoReconnect|verifyServerCertificate|verifyHostname)$": {
      "type": "boolean"
    },
    "^pdr\\.(mqtt|ros|udp)\\.[0-9]+\\.reconnect(Delay|MaximumDelay)Milliseconds$": {
      "type": "integer", "minimum": 100, "maximum": 3600000
    },
    "^pdr\\.mqtt\\.[0-9]+\\.serverUri$": {
      "type": "string", "minLength": 1
    },
    "^pdr\\.mqtt\\.[0-9]+\\.(username|password|trustStore|keyStore|privateKey|privateKeyPassword|enabledCipherSuites)$": {
      "type": "string"
    },
    "^pdr\\.mqtt\\.[0-9]+\\.(username|password|privateKeyPassword)Environment$": {
      "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "^pdr\\.mqtt\\.[0-9]+\\.keepAliveSeconds$": {
      "type": "integer", "minimum": 0, "maximum": 86400
    },
    "^pdr\\.mqtt\\.[0-9]+\\.connectTimeoutSeconds$": {
      "type": "integer", "minimum": 1, "maximum": 3600
    },
    "^pdr\\.ros\\.[0-9]+\\.uri$": {
      "type": "string", "pattern": "^wss?://", "minLength": 1
    },
    "^pdr\\.ros\\.[0-9]+\\.(authorization|trustStore|clientCertificate|privateKey)$": {
      "type": "string"
    },
    "^pdr\\.ros\\.[0-9]+\\.authorizationEnvironment$": {
      "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "^pdr\\.ros\\.[0-9]+\\.maximumMessageSize$": {
      "type": "integer", "minimum": 1, "maximum": 2147483647
    },
    "^pdr\\.ros\\.[0-9]+\\.connectTimeoutSeconds$": {
      "type": "integer", "minimum": 1, "maximum": 3600
    },
    "^pdr\\.udp\\.[0-9]+\\.(localHost|remoteHost)$": {
      "type": "string", "minLength": 1
    },
    "^pdr\\.udp\\.[0-9]+\\.localPort$": {
      "type": "integer", "minimum": 0, "maximum": 65535
    },
    "^pdr\\.udp\\.[0-9]+\\.remotePort$": {
      "type": "integer", "minimum": 1, "maximum": 65535
    }
  },
  "additionalProperties": true
}
