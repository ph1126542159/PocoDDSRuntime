{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-secret-provider-config.schema.json",
  "title": "Pinned external-command Secret Provider",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "providerId", "kind", "secretIds", "protocolMajor", "minimumProtocolMinor", "requiredCapabilities", "executable", "executableSha256", "arguments", "artifactPins", "environmentVariables", "timeoutSeconds", "maxResponseBytes", "maxSecretBytes"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]}, "product": {"const": "PocoDDSRuntimeTeamContractSecretProviderConfig"},
    "providerId": {"$ref": "#/$defs/id"}, "kind": {"const": "external-command"},
    "secretIds": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "protocolMajor": {"type": "integer", "minimum": 1, "maximum": 65535}, "minimumProtocolMinor": {"type": "integer", "minimum": 0, "maximum": 65535},
    "requiredCapabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}},
    "executable": {"type": "string", "minLength": 1}, "executableSha256": {"$ref": "#/$defs/sha256"},
    "arguments": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "artifactPins": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "environmentVariables": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}},
    "optionalEnvironmentVariables": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30}, "maxResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
    "maxSecretBytes": {"type": "integer", "minimum": 1, "maximum": 65536},
    "leasePolicy": {"type": "object", "additionalProperties": false, "required": ["requestedLeaseSeconds", "minimumRemainingSeconds"], "properties": {"requestedLeaseSeconds": {"type": "integer", "minimum": 2, "maximum": 3600}, "minimumRemainingSeconds": {"type": "integer", "minimum": 1, "maximum": 3599}}}
  },
  "allOf": [
    {"if": {"properties": {"schemaVersion": {"const": 2}}}, "then": {"required": ["leasePolicy", "optionalEnvironmentVariables"]}, "else": {"not": {"anyOf": [{"required": ["leasePolicy"]}, {"required": ["optionalEnvironmentVariables"]}]}}}
  ],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
