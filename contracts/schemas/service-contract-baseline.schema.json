{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.dev/contracts/service-contract-baseline.schema.json",
  "title": "Published production Bundle service-contract baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "bundles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeServiceContractBaseline"},
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/bundle"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version", "serviceName"],
      "properties": {
        "contract": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"},
        "serviceName": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,192}$"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "versionRange", "required", "minimumProviders"],
      "properties": {
        "contract": {"$ref": "#/$defs/identifier"},
        "versionRange": {"type": "string", "minLength": 1, "maxLength": 128},
        "required": {"type": "boolean"},
        "minimumProviders": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner", "path", "bundleVersion", "runLevel", "lazyStart",
        "provides", "requires"
      ],
      "properties": {
        "owner": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "pattern": "^[^/].*/bundle/service-contracts\\.json$"},
        "bundleVersion": {"$ref": "#/$defs/version"},
        "runLevel": {"type": "integer", "minimum": 0, "maximum": 999},
        "lazyStart": {"type": "boolean"},
        "provides": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/provider"}},
        "requires": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/requirement"}}
      }
    }
  }
}
