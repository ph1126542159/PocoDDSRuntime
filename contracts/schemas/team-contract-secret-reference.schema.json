{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-secret-reference.schema.json",
  "title": "Version-pinned secret reference",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "providerId", "secretId"],
  "properties": {
    "kind": {"enum": ["secret-ref", "secret-rotation-ref"]},
    "providerId": {"$ref": "#/$defs/id"}, "secretId": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/id"},
    "versions": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "fallbackUntil": {"type": "string", "format": "date-time"}
  },
  "oneOf": [
    {"properties": {"kind": {"const": "secret-ref"}}, "required": ["version"], "not": {"anyOf": [{"required": ["versions"]}, {"required": ["fallbackUntil"]}]}},
    {"properties": {"kind": {"const": "secret-rotation-ref"}}, "required": ["versions", "fallbackUntil"], "not": {"required": ["version"]}}
  ],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
