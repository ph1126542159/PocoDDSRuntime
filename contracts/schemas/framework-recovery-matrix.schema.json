{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.dev/contracts/framework-recovery-matrix.schema.json",
  "title": "PocoDDSRuntime executable fault-recovery matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "matrixVersion", "product", "profile", "requiredScopes", "scenarios"],
  "properties": {
    "$schema": {"type":"string", "minLength":1},
    "schemaVersion": {"const":1},
    "matrixVersion": {"type":"string", "pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "product": {"const":"PocoDDSRuntime"},
    "profile": {"type":"string", "minLength":1},
    "requiredScopes": {
      "type":"array", "minItems":1, "uniqueItems":true,
      "items":{"enum":["host","runtime","process","bundle","service","transport","persistence"]}
    },
    "scenarios": {
      "type":"array", "minItems":1,
      "items":{"$ref":"#/$defs/scenario"}
    }
  },
  "$defs": {
    "id": {"type":"string", "pattern":"^[a-z0-9][a-z0-9-]*$"},
    "owner": {"type":"string", "pattern":"^team/[a-z0-9][a-z0-9-]*$"},
    "scenario": {
      "type":"object", "additionalProperties":false,
      "required":["id","title","component","owner","scope","fault","injection","recoveryPolicy","test","requiredLabels","timeoutSeconds","assertions"],
      "properties": {
        "id":{"type":"string", "pattern":"^PDR-REC-[0-9]{4,}$"},
        "title":{"type":"string", "minLength":1},
        "component":{"$ref":"#/$defs/id"},
        "owner":{"$ref":"#/$defs/owner"},
        "scope":{"enum":["host","runtime","process","bundle","service","transport","persistence"]},
        "fault":{"$ref":"#/$defs/id"},
        "injection":{"type":"string", "minLength":1},
        "recoveryPolicy":{"type":"string", "minLength":1},
        "test":{"$ref":"#/$defs/id"},
        "requiredLabels":{"type":"array", "minItems":1, "uniqueItems":true, "items":{"$ref":"#/$defs/id"}},
        "timeoutSeconds":{"type":"integer", "minimum":1, "maximum":120},
        "assertions":{"type":"array", "minItems":1, "items":{"$ref":"#/$defs/assertion"}}
      }
    },
    "assertion": {
      "type":"object", "additionalProperties":false,
      "required":["id","marker","invariant"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},
        "marker":{"type":"string", "minLength":1, "maxLength":256},
        "invariant":{"type":"string", "minLength":1}
      }
    }
  }
}
