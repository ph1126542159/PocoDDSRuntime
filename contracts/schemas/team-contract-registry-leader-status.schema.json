{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-registry-leader-status.schema.json",
  "title": "Verified writable Registry leader status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "passed", "mode", "writable", "authorityId", "registryId", "leaderId", "fencingToken", "grantSha256", "revision", "stateSha256", "expiresAt", "verifiedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractRegistryLeaderStatus"},
    "passed": {"const": true},
    "mode": {"const": "leader-writable"},
    "writable": {"const": true},
    "authorityId": {"$ref": "#/$defs/id"},
    "registryId": {"$ref": "#/$defs/id"},
    "leaderId": {"$ref": "#/$defs/id"},
    "fencingToken": {"type": "integer", "minimum": 1},
    "grantSha256": {"$ref": "#/$defs/sha256"},
    "revision": {"type": "integer", "minimum": 0},
    "stateSha256": {"$ref": "#/$defs/sha256"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "verifiedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
