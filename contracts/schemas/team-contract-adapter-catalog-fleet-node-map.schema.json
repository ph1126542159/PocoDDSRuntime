{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-catalog-fleet-node-map.schema.json",
  "title": "Reference Adapter Catalog Fleet node map", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "executorId", "auditPath", "nodes"],
  "properties": {"schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterCatalogFleetNodeMap"}, "executorId": {"$ref": "#/$defs/id"}, "auditPath": {"type": "string", "minLength": 1}, "nodes": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["nodeId", "stateDir", "transactionDir", "lifecycleStateDir", "reconcilerConfigPath", "reconcilerConfigSha256", "catalogPath", "catalogSha256", "expectedActivationGeneration", "healthMode"], "properties": {"nodeId": {"$ref": "#/$defs/pathId"}, "stateDir": {"type": "string", "minLength": 1}, "transactionDir": {"type": "string", "minLength": 1}, "lifecycleStateDir": {"type": "string", "minLength": 1}, "reconcilerConfigPath": {"type": "string", "minLength": 1}, "reconcilerConfigSha256": {"$ref": "#/$defs/sha256"}, "catalogPath": {"type": "string", "minLength": 1}, "catalogSha256": {"$ref": "#/$defs/sha256"}, "expectedActivationGeneration": {"type": "integer", "minimum": 1}, "healthMode": {"enum": ["healthy", "unhealthy"]}}}}},
  "$defs": {"pathId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,60}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
