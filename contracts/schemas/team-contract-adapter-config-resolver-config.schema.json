{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-adapter-config-resolver-config.schema.json",
  "title": "Pinned external-command Adapter configuration resolver",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "resolverId", "kind", "configIds", "protocolMajor", "minimumProtocolMinor", "requiredCapabilities", "executable", "executableSha256", "arguments", "artifactPins", "environmentVariables", "timeoutSeconds", "maxResponseBytes"],
  "properties": {
    "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractAdapterConfigResolverConfig"},
    "resolverId": {"$ref": "#/$defs/id"}, "kind": {"const": "external-command"},
    "configIds": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "protocolMajor": {"type": "integer", "minimum": 1, "maximum": 65535}, "minimumProtocolMinor": {"type": "integer", "minimum": 0, "maximum": 65535},
    "requiredCapabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}},
    "executable": {"type": "string", "minLength": 1}, "executableSha256": {"$ref": "#/$defs/sha256"},
    "arguments": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "artifactPins": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "environmentVariables": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30}, "maxResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
