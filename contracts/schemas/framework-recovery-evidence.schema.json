{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocodds.dev/contracts/framework-recovery-evidence.schema.json",
  "title": "PocoDDSRuntime fault-recovery matrix execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","operation","passed","matrixVersion","profile","configuration","matrixSha256","catalogSha256","ctestCatalogSha256","runtimeArtifactCount","runtimeArtifactSetSha256","ctestVersion","requiredScopes","scenarioCount","startedAt","finishedAt","preflight","results","violations"],
  "properties": {
    "schemaVersion":{"const":2},
    "operation":{"const":"framework-recovery-matrix-evidence"},
    "passed":{"type":"boolean"},
    "matrixVersion":{"type":"string", "pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile":{"type":"string", "minLength":1},
    "configuration":{"type":"string", "minLength":1},
    "matrixSha256":{"$ref":"#/$defs/sha256"},
    "catalogSha256":{"$ref":"#/$defs/sha256"},
    "ctestCatalogSha256":{"$ref":"#/$defs/sha256"},
    "runtimeArtifactCount":{"type":"integer", "minimum":0},
    "runtimeArtifactSetSha256":{"$ref":"#/$defs/sha256"},
    "ctestVersion":{"type":"string", "minLength":1},
    "requiredScopes":{"type":"array", "minItems":1, "uniqueItems":true, "items":{"type":"string"}},
    "scenarioCount":{"type":"integer", "minimum":1},
    "startedAt":{"type":"string", "format":"date-time"},
    "finishedAt":{"type":"string", "format":"date-time"},
    "preflight":{"type":"array", "minItems":1, "items":{"$ref":"#/$defs/preflight"}},
    "results":{"type":"array", "items":{"$ref":"#/$defs/result"}},
    "violations":{"type":"array", "items":{"type":"string", "minLength":1}}
  },
  "allOf": [
    {
      "if":{"properties":{"passed":{"const":true}}},
      "then":{"properties":{"violations":{"maxItems":0},"results":{"minItems":1}}},
      "else":{"properties":{"violations":{"minItems":1}}}
    }
  ],
  "$defs": {
    "sha256":{"type":"string", "pattern":"^[0-9a-f]{64}$"},
    "preflight": {
      "type":"object", "additionalProperties":false,
      "required":["id","test","registered","observedLabels","missingLabels","commandSha256","commandArtifactSetSha256"],
      "properties": {
        "id":{"type":"string", "pattern":"^PDR-REC-[0-9]{4,}$"},
        "test":{"type":"string", "minLength":1},
        "registered":{"type":"boolean"},
        "observedLabels":{"type":"array", "uniqueItems":true, "items":{"type":"string"}},
        "missingLabels":{"type":"array", "uniqueItems":true, "items":{"type":"string"}},
        "commandSha256":{"type":"string", "pattern":"^$|^[0-9a-f]{64}$"},
        "commandArtifactSetSha256":{"type":"string", "pattern":"^$|^[0-9a-f]{64}$"}
      }
    },
    "assertion": {
      "type":"object", "additionalProperties":false,
      "required":["id","marker","invariant","observed"],
      "properties": {
        "id":{"type":"string", "minLength":1},
        "marker":{"type":"string", "minLength":1},
        "invariant":{"type":"string", "minLength":1},
        "observed":{"type":"boolean"}
      }
    },
    "result": {
      "type":"object", "additionalProperties":false,
      "required":["id","scope","component","owner","test","passed","exitCode","timedOut","elapsedMilliseconds","outputBytes","outputSha256","assertions","diagnostic"],
      "properties": {
        "id":{"type":"string", "pattern":"^PDR-REC-[0-9]{4,}$"},
        "scope":{"type":"string", "minLength":1},
        "component":{"type":"string", "minLength":1},
        "owner":{"type":"string", "pattern":"^team/[a-z0-9][a-z0-9-]*$"},
        "test":{"type":"string", "minLength":1},
        "passed":{"type":"boolean"},
        "exitCode":{"type":"integer"},
        "timedOut":{"type":"boolean"},
        "elapsedMilliseconds":{"type":"integer", "minimum":0},
        "outputBytes":{"type":"integer", "minimum":0},
        "outputSha256":{"$ref":"#/$defs/sha256"},
        "assertions":{"type":"array", "minItems":1, "items":{"$ref":"#/$defs/assertion"}},
        "diagnostic":{"type":"string"}
      }
    }
  }
}
