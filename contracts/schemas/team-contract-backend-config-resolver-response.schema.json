{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-backend-config-resolver-response.schema.json",
  "title": "Backend configuration resolver response",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "requestId", "resolverId", "operation", "passed", "reference", "configPath", "configSha256", "error"],
  "properties": {
    "schemaVersion": {"const": 1}, "product": {"const": "PocoDDSRuntimeTeamContractBackendConfigResolverResponse"},
    "requestId": {"$ref": "#/$defs/id"}, "resolverId": {"$ref": "#/$defs/id"}, "operation": {"const": "resolve"}, "passed": {"type": "boolean"},
    "reference": {"$ref": "#/$defs/reference"}, "configPath": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "configSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "error": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 1024}]}
  },
  "allOf": [
    {"if": {"properties": {"passed": {"const": true}}}, "then": {"properties": {"configPath": {"type": "string", "minLength": 1}, "configSha256": {"$ref": "#/$defs/sha256"}, "error": {"type": "null"}}}, "else": {"properties": {"configPath": {"type": "null"}, "configSha256": {"type": "null"}, "error": {"type": "string", "minLength": 1}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["kind", "resolverId", "configId", "backendId", "revision"], "properties": {"kind": {"const": "backend-config-ref"}, "resolverId": {"$ref": "#/$defs/id"}, "configId": {"$ref": "#/$defs/id"}, "backendId": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}}}
  }
}
