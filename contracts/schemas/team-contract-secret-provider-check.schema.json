{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pocoddsruntime.local/schemas/team-contract-secret-provider-check.schema.json",
  "title": "Redacted Secret Provider availability check", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "product", "passed", "reference", "provider", "available", "checkedAt"],
  "properties": {"schemaVersion": {"enum": [1, 2]}, "product": {"const": "PocoDDSRuntimeTeamContractSecretProviderCheck"}, "passed": {"const": true}, "reference": {"$ref": "team-contract-secret-reference.schema.json"}, "provider": {"type": "object", "additionalProperties": false, "required": ["kind", "providerId", "configPath", "configSha256", "capabilityManifestSha256"], "properties": {"kind": {"const": "external-command"}, "providerId": {"$ref": "#/$defs/id"}, "configPath": {"type": "string", "minLength": 1}, "configSha256": {"$ref": "#/$defs/sha256"}, "capabilityManifestSha256": {"$ref": "#/$defs/sha256"}}}, "available": {"const": true}, "checkedAt": {"type": "string", "format": "date-time"}, "selectedVersion": {"$ref": "#/$defs/id"}, "leaseExpiresAt": {"type": "string", "format": "date-time"}},
  "allOf": [{"if": {"properties": {"schemaVersion": {"const": 2}}}, "then": {"required": ["selectedVersion", "leaseExpiresAt"]}, "else": {"not": {"anyOf": [{"required": ["selectedVersion"]}, {"required": ["leaseExpiresAt"]}]}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
