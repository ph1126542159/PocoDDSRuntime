{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocoddsruntime.local/schemas/team-contract-trust-policy.schema.json",
  "title": "Cross-team contract package publisher trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "policyId", "allowedPublishers", "revokedKeys"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "PocoDDSRuntimeTeamContractTrustPolicy"},
    "policyId": {"$ref": "#/$defs/identifier"},
    "allowedPublishers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner", "keyId", "algorithm", "publicKey", "publicKeySha256",
          "notBefore", "notAfter"
        ],
        "properties": {
          "owner": {"$ref": "#/$defs/identifier"},
          "keyId": {"$ref": "#/$defs/identifier"},
          "algorithm": {"const": "Ed25519"},
          "publicKey": {"type": "string", "pattern": "^keys/[A-Za-z0-9._-]+\\.pem$"},
          "publicKeySha256": {"$ref": "#/$defs/sha256"},
          "packageIds": {
            "type": "array", "maxItems": 256, "uniqueItems": true,
            "items": {"$ref": "#/$defs/packageId"}
          },
          "packagePrefixes": {
            "type": "array", "maxItems": 64, "uniqueItems": true,
            "items": {"$ref": "#/$defs/packagePrefix"}
          },
          "notBefore": {"type": "string", "format": "date-time"},
          "notAfter": {"type": "string", "format": "date-time"}
        },
        "anyOf": [
          {"required": ["packageIds"], "properties": {"packageIds": {"minItems": 1}}},
          {"required": ["packagePrefixes"], "properties": {"packagePrefixes": {"minItems": 1}}}
        ]
      }
    },
    "revokedKeys": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "revokedAt", "reason"],
        "properties": {
          "keyId": {"$ref": "#/$defs/identifier"},
          "revokedAt": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "packageId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "packagePrefix": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}\\.$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
