{
  "$schema": "schemas/framework-components.schema.json",
  "schemaVersion": 1,
  "product": "PocoDDSRuntimeFrameworkComponents",
  "globalPaths": [
    ".github/", "CMakeLists.txt", "CMakePresets.json", "cmake/", "config/",
    "contracts/", "deploy/", "release/", "scripts/", "tests/", "tools/",
    "platform/OSP/CMakeLists.txt", "platform/CMakeLists.txt", "SubSystem/CMakeLists.txt"
  ],
  "components": [
    {"id":"docs","owner":"team/docs","paths":["docs/"],"requires":[],"buildTargets":[],"testLabels":["docs"]},
    {"id":"runtime-core","owner":"team/runtime-core","paths":["runtime-core/"],"requires":[],"buildTargets":["PDRRuntimeCore"],"testLabels":["core"]},
    {"id":"application","owner":"team/runtime-core","paths":["application/"],"requires":["platform-foundation"],"buildTargets":[],"testLabels":["framework"]},
    {"id":"native-process","owner":"team/runtime-core","paths":["process/"],"requires":["runtime-core"],"buildTargets":["PDRNativeProcess"],"testLabels":["process"]},
    {"id":"security","owner":"team/security","paths":["platform/security/"],"requires":["runtime-core"],"buildTargets":["PDRSecurity"],"testLabels":["security"]},
    {"id":"configuration","owner":"team/configuration","paths":["platform/configuration/"],"requires":["security"],"buildTargets":["PDRConfiguration"],"testLabels":["configuration"]},
    {"id":"platform-foundation","owner":"team/runtime-governance","paths":["platform/health/","platform/observability/","platform/persistence/","platform/reliability/"],"requires":["runtime-core","configuration"],"buildTargets":[],"testLabels":["reliability"]},
    {"id":"osp","owner":"team/osp-runtime","paths":["platform/OSP/ActiveRecord/","platform/OSP/BundleAdmin/","platform/OSP/BundleCreator/","platform/OSP/CodeCacheUtility/","platform/OSP/Core/","platform/OSP/Crypto/","platform/OSP/Data/","platform/OSP/doc/","platform/OSP/include/","platform/OSP/JS/","platform/OSP/ManagementAuth/","platform/OSP/Net/","platform/OSP/NetSSL_OpenSSL/","platform/OSP/samples/","platform/OSP/SecureWebServer/","platform/OSP/SimpleAuth/","platform/OSP/src/","platform/OSP/StripBundle/","platform/OSP/tests/","platform/OSP/testsuite/","platform/OSP/Unit/","platform/OSP/Web/","platform/OSP/WebEvent/","platform/OSP/WebServer/"],"requires":["security","platform-foundation"],"buildTargets":["OSP"],"testLabels":["runtime","bundle"]},
    {"id":"platform-adapters","owner":"team/osp-runtime","paths":["platform/CodeGeneration/","platform/Geo/","platform/Serial/","platform/WebTunnel/"],"requires":["runtime-core","platform-foundation","osp"],"buildTargets":[],"testLabels":["runtime"]},
    {"id":"protocols","owner":"team/device-platform","paths":["platform/protocols/"],"requires":["runtime-core","configuration","platform-foundation","platform-adapters","osp"],"buildTargets":[],"testLabels":["protocol"]},
    {"id":"devices","owner":"team/device-platform","paths":["platform/devices/"],"requires":["runtime-core","configuration","platform-foundation","osp","protocols"],"buildTargets":["PDRDeviceCore"],"testLabels":["device"]},
    {"id":"transports","owner":"team/transports","paths":["transports/"],"requires":["runtime-core","protocols","runtime-integration"],"buildTargets":["PDRFastDdsTransport","PDRMqttTransport"],"testLabels":["transport"]},
    {"id":"runtime-governance","owner":"team/runtime-governance","paths":["platform/capabilities/","platform/configtransaction/","platform/lifecycle/","platform/membership/","platform/resourcegovernance/","platform/scheduling/","platform/schemaregistry/","platform/serviceclient/","platform/servicedependency/","platform/servicedirectory/","platform/storeforward/","platform/transportproviders/","platform/workflow/"],"requires":["runtime-core","configuration","platform-foundation","security","osp"],"buildTargets":[],"testLabels":["capability","circuit-breaker","configuration","lifecycle","membership","provider","recovery","resource-governance","retry","routing","scheduling","schema","service-client","service-directory","transaction","workflow"]},
    {"id":"gateway-runtime","owner":"team/device-platform","paths":["platform/gateways/"],"requires":["configuration","runtime-governance","devices","protocols","osp"],"buildTargets":[],"testLabels":["gateway"]},
    {"id":"runtime-integration","owner":"team/osp-runtime","paths":["platform/DDS/","platform/ProcessManagement/"],"requires":["runtime-core","platform-foundation","osp","devices"],"buildTargets":[],"testLabels":["runtime"]},
    {"id":"osp-management","owner":"team/runtime-operations","paths":["platform/OSP/AlertWebhook/","platform/OSP/DiagnosticTerminal/","platform/OSP/HealthEndpoint/","platform/OSP/ProcessGraphEndpoint/","platform/OSP/SystemMonitoring/"],"requires":["configuration","platform-foundation","runtime-integration","security","osp","protocols","devices","runtime-governance"],"buildTargets":[],"testLabels":["runtime","security"]},
    {"id":"bundle-management","owner":"team/osp-runtime","paths":["platform/BundleManagement/"],"requires":["osp","security"],"buildTargets":["PDRBundleManagement"],"testLabels":["bundle","bundle-deployment","security"]},
    {"id":"governance-services","owner":"team/runtime-governance","paths":["services/CapabilityManagement/","services/CapabilityRuntime/","services/ConfigurationRuntime/","services/HttpInvocationProvider/","services/LifecycleRuntime/","services/MembershipRuntime/","services/OutboxRuntime/","services/ResourceGovernor/","services/SchedulerRuntime/","services/SchemaRegistryRuntime/","services/ServiceClientRuntime/","services/ServiceDependencyRuntime/","services/ServiceDirectoryRuntime/","services/TransportRegistryRuntime/","services/WorkflowRuntime/"],"requires":["configuration","platform-foundation","runtime-integration","security","osp","transports","runtime-governance"],"buildTargets":["PDRGovernanceServices"],"testLabels":["service","runtime","capability","configuration","http","lifecycle","membership","provider","recovery","resource-governance","retry","routing","scheduling","schema","security","service-client","service-directory","transaction","workflow"]},
    {"id":"gateway-services","owner":"team/device-platform","paths":["services/BuiltinDeviceFactories/","services/BuiltinProtocolFactories/","services/BuiltinTransportFactories/","services/DeviceGateway/","services/ProtocolGateway/"],"requires":["configuration","platform-foundation","runtime-integration","security","osp","protocols","devices","transports","runtime-governance","gateway-runtime"],"buildTargets":["PDRGatewayServices"],"testLabels":["service","runtime","gateway","device","protocol","transport"]},
    {"id":"utility-services","owner":"team/services","paths":["services/DeviceStatus/","services/MobileConnection/","services/NetworkEnvironment/","services/UnitsOfMeasure/","services/WebEvent/"],"requires":["platform-foundation","runtime-integration","osp"],"buildTargets":["PDRUtilityServices"],"testLabels":["service","runtime"]},
    {"id":"launcher","owner":"team/runtime-operations","paths":["SubSystem/launcher/"],"requires":["bundle-management","osp"],"buildTargets":["pdr-launcher"],"testLabels":["process","bundle-deployment","recovery"]},
    {"id":"subprocess-hosts","owner":"team/runtime-operations","paths":["SubSystem/diagnostic-agent/","SubSystem/plugin-host/","SubSystem/qt3d/"],"requires":["runtime-core","platform-foundation","osp","runtime-integration"],"buildTargets":[],"testLabels":["process"]},
    {"id":"server","owner":"team/runtime-operations","paths":["server/"],"requires":["bundle-management","configuration","platform-foundation","runtime-integration","osp","protocols","devices","governance-services","gateway-services","utility-services"],"buildTargets":["pdr-runtime"],"testLabels":["runtime","integration"]},
    {"id":"sdk","owner":"team/sdk","paths":["sdk/"],"requires":["application","configuration","devices","platform-foundation","runtime-governance","security"],"buildTargets":["PDRSDK"],"testLabels":["sdk"]},
    {"id":"plugin-sdk","owner":"team/sdk","paths":["cmake/PocoDDSPlugins.cmake"],"requires":["gateway-runtime","osp","runtime-governance","sdk"],"buildTargets":["PDRPlugins"],"testLabels":["sdk","bundle"]},
    {"id":"webui","owner":"team/webui","paths":["webui/"],"requires":["server"],"buildTargets":[],"testLabels":["webui"]},
    {"id":"robotics","owner":"team/robotics","paths":["robotics/"],"requires":["runtime-core","transports"],"buildTargets":[],"testLabels":["robotics"]}
  ]
}
