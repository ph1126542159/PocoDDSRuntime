{
  "runtimeVersion": "0.1.0",
  "cmakeTargets": ["PocoDDS::Application", "PocoDDS::Configuration", "PocoDDS::DeviceCore", "PocoDDS::Health", "PocoDDS::Persistence", "PocoDDS::Reliability", "PocoDDS::SDK"],
  "publicHeaders": {
    "application/include/PocoDDS/Application/Application.h": ["CommandContext", "Error", "IWorkflow", "Result", "SequentialWorkflow", "WorkflowEvent", "WorkflowRegistry", "WorkflowState", "WorkflowStep"],
    "platform/configuration/include/PocoDDS/Configuration/ConfigurationValidator.h": ["AbstractConfiguration", "ConfigurationValidator", "ValidationIssue"],
    "platform/configuration/include/PocoDDS/Configuration/IndexedConfiguration.h": ["AbstractConfiguration", "IndexedInstance"],
    "platform/devices/Devices/include/PocoDDS/Devices/Device.h": ["Device", "DeviceDiagnostics", "DeviceSnapshot", "DeviceState", "DiagnosticDevice"],
    "platform/devices/Devices/include/PocoDDS/Devices/DeviceService.h": ["DeviceService"],
    "platform/reliability/include/PocoDDS/Reliability/Reliability.h": ["BoundedQueue", "Bulkhead", "CircuitBreaker", "Deadline", "FailureKind", "IdempotencyWindow", "Lease", "RetryPolicy", "ShutdownSignal"],
    "platform/health/include/PocoDDS/Health/Health.h": ["AggregateReport", "HealthRegistry", "IHealthContributor", "Report", "Status"],
    "platform/persistence/include/PocoDDS/Persistence/Persistence.h": ["IRepository", "IUnitOfWork", "Migration", "MigrationPlan"],
    "sdk/include/PocoDDS/SDK/SDK.h": [],
    "sdk/include/PocoDDS/SDK/Version.h.in": []
  },
  "configuration": {
    "required": ["osp.web.server.host", "osp.web.server.port", "pdr.fastdds.domainId"],
    "properties": {
      "observability.history.retentionDays": {"type": "integer", "minimum": 1},
      "observability.metrics.exportIntervalMilliseconds": {"type": "integer", "minimum": 100},
      "observability.metrics.exportTimeoutMilliseconds": {"type": "integer", "minimum": 100},
      "observability.metrics.maximumSeries": {"type": "integer", "minimum": 1},
      "observability.metrics.otlpHttpEndpoint": {"type": "string"},
      "observability.metrics.serviceInstanceId": {"type": "string"},
      "observability.metrics.serviceName": {"type": "string", "minLength": 1},
      "osp.web.server.host": {"type": "string", "minLength": 1},
      "osp.web.server.port": {"type": "integer", "minimum": 1, "maximum": 65535},
      "pdr.fastdds.domainId": {"type": "integer", "minimum": 0, "maximum": 232},
      "pdr.gnss.baudRate": {"type": "integer", "minimum": 1},
      "pdr.modbus.port": {"type": "integer", "minimum": 1, "maximum": 65535},
      "pdr.modbus.unitId": {"type": "integer", "minimum": 0, "maximum": 247},
      "pdr.serial.baudRate": {"type": "integer", "minimum": 1},
      "pdr.subprocess.shutdownTimeoutMilliseconds": {"type": "integer", "minimum": 1}
    },
    "patterns": {
      "^pdr\\.(simulation|modbus|serial|gnss|gpio|xbee|can|led)\\.[0-9]+\\.enabled$": {"type": "boolean"},
      "^pdr\\.(simulation|modbus|serial|gnss|gpio|xbee|can|led)\\.[0-9]+\\.id$": {"type": "string", "minLength": 1},
      "^pdr\\.(simulation|modbus|serial|gnss|gpio|xbee|can|led)\\.count$": {"type": "integer", "minimum": 0, "maximum": 256},
      "^pdr\\.(serial|gnss|xbee)\\.[0-9]+\\.baudRate$": {"type": "integer", "minimum": 1, "maximum": 4000000},
      "^pdr\\.can\\.[0-9]+\\.bitLength$": {"type": "integer", "minimum": 1, "maximum": 64},
      "^pdr\\.can\\.[0-9]+\\.bitOffset$": {"type": "integer", "minimum": 0, "maximum": 63},
      "^pdr\\.gpio\\.[0-9]+\\.pin$": {"type": "integer", "minimum": 0},
      "^pdr\\.modbus\\.[0-9]+\\.port$": {"type": "integer", "minimum": 1, "maximum": 65535},
      "^pdr\\.modbus\\.[0-9]+\\.unitId$": {"type": "integer", "minimum": 0, "maximum": 247},
      "^pdr\\.xbee\\.[0-9]+\\.analogChannel$": {"type": "integer", "minimum": 0, "maximum": 15}
    }
  },
  "openapi": {
    "version": "0.1.0",
    "operations": ["GET /api/v1/business-trace-history", "GET /api/v1/business-traces", "GET /api/v1/devices", "GET /api/v1/heartbeat-businesses", "GET /api/v1/process-config", "GET /api/v1/process-detail", "GET /api/v1/process-logs", "GET /api/v1/system-metrics", "GET /health/detail", "GET /health/live", "GET /health/ready", "POST /api/v1/bundle-lifecycle", "POST /api/v1/process-config", "POST /api/v1/process-lifecycle"]
  },
  "asyncapi": {
    "version": "0.1.0",
    "channels": {
      "heartbeatRequest": "pdr.process.heartbeat.request",
      "heartbeatResponse": "pdr.process.heartbeat.response",
      "observabilitySpan": "pdr.observability.span",
      "qt3dWindowCommand": "pdr.qt3d.window.command",
      "qt3dWindowResponse": "pdr.qt3d.window.response",
      "qt3dWorkflowRequest": "pdr.qt3d.workflow.request",
      "qt3dWorkflowResponse": "pdr.qt3d.workflow.response"
    }
  }
}
