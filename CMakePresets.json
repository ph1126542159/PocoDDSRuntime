{
  "version": 5,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/profiles/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "embedded",
      "inherits": "base",
      "description": "Embedded/PetaLinux foundation profile",
      "cacheVariables": {
        "PDR_PROFILE": "embedded",
        "PDR_ENABLE_OBSERVABILITY": "OFF",
        "MYIOT_ENABLE_DATA_MODULES": "OFF",
        "PDR_BUILD_WEBUI": "OFF",
        "PDR_BUILD_LAUNCHER": "ON",
        "PDR_BUILD_QT3D": "OFF"
      }
    },
    {
      "name": "edge-test",
      "inherits": "base",
      "description": "Edge and test-station profile",
      "cacheVariables": {
        "PDR_PROFILE": "edge-test",
        "PDR_ENABLE_OBSERVABILITY": "ON",
        "MYIOT_ENABLE_DATA_MODULES": "OFF",
        "PDR_BUILD_WEBUI": "ON",
        "PDR_BUILD_LAUNCHER": "ON",
        "PDR_BUILD_QT3D": "ON"
      }
    },
    {
      "name": "server",
      "inherits": "base",
      "description": "Server profile with data and observability modules",
      "cacheVariables": {
        "PDR_PROFILE": "server",
        "PDR_ENABLE_OBSERVABILITY": "ON",
        "MYIOT_ENABLE_DATA_MODULES": "ON",
        "PDR_BUILD_WEBUI": "ON",
        "PDR_BUILD_LAUNCHER": "ON",
        "PDR_BUILD_QT3D": "OFF"
      }
    },
    {
      "name": "full",
      "inherits": "server",
      "displayName": "Full build (all targets)",
      "description": "Default desktop profile; automatically bootstraps all dependencies",
      "binaryDir": "${sourceDir}/build/full",
      "cacheVariables": {
        "PDR_AUTO_BOOTSTRAP_DEPENDENCIES": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "embedded", "configurePreset": "embedded" },
    { "name": "edge-test", "configurePreset": "edge-test" },
    { "name": "server", "configurePreset": "server" },
    {
      "name": "full",
      "configurePreset": "full",
      "configuration": "Release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "edge-test",
      "configurePreset": "edge-test",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "nightly-fault-injection",
      "configurePreset": "edge-test",
      "description": "Deterministic dependency outage, retry, duplicate, backpressure and shutdown tests",
      "filter": { "include": { "label": "fault-injection" } },
      "output": { "outputOnFailure": true }
    }
  ]
}
