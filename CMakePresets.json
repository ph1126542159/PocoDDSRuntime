{
  "version": 5,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/profiles/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "embedded",
      "inherits": "base",
      "description": "Embedded/PetaLinux foundation profile",
      "cacheVariables": {
        "PDR_PROFILE": "embedded",
        "PDR_ENABLE_OBSERVABILITY": "OFF",
        "MYIOT_ENABLE_DATA_MODULES": "OFF",
        "PDR_BUILD_WEBUI": "OFF",
        "PDR_BUILD_LAUNCHER": "ON",
        "PDR_BUILD_QT3D": "OFF"
      }
    },
    {
      "name": "edge-test",
      "inherits": "base",
      "description": "Edge and test-station profile",
      "cacheVariables": {
        "PDR_PROFILE": "edge-test",
        "PDR_ENABLE_OBSERVABILITY": "ON",
        "MYIOT_ENABLE_DATA_MODULES": "OFF",
        "PDR_BUILD_WEBUI": "ON",
        "PDR_BUILD_LAUNCHER": "ON",
        "PDR_BUILD_QT3D": "OFF"
      }
    },
    {
      "name": "server",
      "inherits": "base",
      "description": "Server profile with data and observability modules",
      "cacheVariables": {
        "PDR_PROFILE": "server",
        "PDR_ENABLE_OBSERVABILITY": "ON",
        "MYIOT_ENABLE_DATA_MODULES": "ON",
        "PDR_BUILD_WEBUI": "ON",
        "PDR_BUILD_LAUNCHER": "ON",
        "PDR_BUILD_QT3D": "OFF"
      }
    },
    {
      "name": "default",
      "inherits": "server",
      "displayName": "Default build",
      "description": "Default desktop profile; builds in the repository's single build tree",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "PDR_AUTO_BOOTSTRAP_DEPENDENCIES": "ON",
        "PDR_BUILD_QT3D": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "server",
      "displayName": "Governed release",
      "description": "Production release gate; requires a clean Git worktree",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "PDR_RELEASE_REQUIRE_CLEAN": "ON"
      }
    },
    {
      "name": "robotics",
      "inherits": "base",
      "displayName": "Embodied robotics runtime core",
      "description": "Cross-platform transport-neutral core; ROS 2 adapters are built with colcon",
      "binaryDir": "${sourceDir}/build/robotics",
      "cacheVariables": {
        "PDR_PROFILE": "custom",
        "PDR_BUILD_LEGACY_RUNTIME": "OFF",
        "PDR_BUILD_ROBOTICS_RUNTIME": "ON",
        "PDR_COMM_BACKEND": "ROS2",
        "PDR_ENABLE_OBSERVABILITY": "OFF",
        "PDR_AUTO_BOOTSTRAP_DEPENDENCIES": "OFF",
        "PDR_BUILD_WEBUI": "OFF",
        "PDR_BUILD_LAUNCHER": "OFF",
        "PDR_BUILD_PLUGIN_HOST": "OFF",
        "PDR_BUILD_QT3D": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "embedded", "configurePreset": "embedded" },
    { "name": "edge-test", "configurePreset": "edge-test" },
    { "name": "server", "configurePreset": "server" },
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Release",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 2
    },
    {
      "name": "robotics",
      "configurePreset": "robotics",
      "configuration": "Release",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "edge-test",
      "configurePreset": "edge-test",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "nightly-fault-injection",
      "configurePreset": "edge-test",
      "description": "Deterministic dependency outage, retry, duplicate, backpressure and shutdown tests",
      "filter": { "include": { "label": "fault-injection" } },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "description": "Full governed release suite with clean-worktree enforcement",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "robotics",
      "configurePreset": "robotics",
      "output": { "outputOnFailure": true }
    }
  ]
}
