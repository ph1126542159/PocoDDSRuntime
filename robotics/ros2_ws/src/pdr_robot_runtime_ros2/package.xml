  <description>ROS 2 lifecycle and action adapter for the PocoDDS robotics core.</description>
  <maintainer email="ph@example.com">ph</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>pdr_robot_msgs</depend>
