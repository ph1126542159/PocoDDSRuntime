# Subprocesses are started in ascending numeric order.
# Paths and working directories are relative to the pdr-runtime directory.
subprocess.count = 1

# Qt3D architecture test subprocess. It is disabled automatically for profiles
# that do not build the Qt3D/observability target.
subprocess.0.enabled = @PDR_QT3D_SUBPROCESS_ENABLED@
subprocess.0.name = pdr-qt3d-subprocess
subprocess.0.location = local
subprocess.0.path = processes/pdr-qt3d-subprocess/pdr-qt3d-subprocess.exe
subprocess.0.workingDirectory = processes/pdr-qt3d-subprocess
subprocess.0.argument.count = 2
subprocess.0.argument.0 = --instance
subprocess.0.argument.1 = main-qt3d
