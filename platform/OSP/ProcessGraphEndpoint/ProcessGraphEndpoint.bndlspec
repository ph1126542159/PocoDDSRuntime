<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>PocoDDS Process Dependency Graph Endpoint</name>
    <symbolicName>pdr.platform.processGraph</symbolicName>
    <version>1.0.0</version>
    <vendor>PocoDDSRuntime</vendor>
    <lazyStart>false</lazyStart>
    <runLevel>91</runLevel>
    <requiredBundles>
      <bundle>
        <symbolicName>osp.core</symbolicName>
        <version>[1.0.0,2.0.0)</version>
      </bundle>
      <bundle>
        <symbolicName>osp.web</symbolicName>
        <version>[1.0.0,2.0.0)</version>
      </bundle>
    </requiredBundles>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
  </code>
  <files>bundle/*</files>
</bundlespec>
