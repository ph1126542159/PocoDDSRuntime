@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(PocoDDSRuntime_PLUGIN_API_VERSION "@PDR_PLUGIN_API_VERSION@")
set(PocoDDSRuntime_PLUGIN_ABI_VERSION "@PDR_PLUGIN_ABI_VERSION@")
set(PocoDDSRuntime_PLUGIN_ABI_FINGERPRINT "@PDR_PLUGIN_ABI_FINGERPRINT@")
set(PocoDDSRuntime_PLUGIN_RUNTIME_RANGE "@PDR_PLUGIN_RUNTIME_RANGE@")
set(PocoDDSRuntime_PLUGIN_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(PocoDDSRuntime_PLUGIN_COMPILER_MAJOR "@PDR_PLUGIN_COMPILER_MAJOR@")

# No components keeps the original lightweight SDK behavior. Protocol users
# request either Protocols or one or more individual protocol components.
if(NOT PocoDDSRuntime_FIND_COMPONENTS)
    set(PocoDDSRuntime_FIND_COMPONENTS SDK)
endif()

set(_pdr_known_components
    SDK Security Plugins Protocols BtLE CAN Modbus MQTT ROS SerialProtocol UDP WebTunnelProtocol XBee)
set(_pdr_poco_components Foundation Util)
set(_pdr_need_paho FALSE)
foreach(_pdr_component IN LISTS PocoDDSRuntime_FIND_COMPONENTS)
    if(NOT _pdr_component IN_LIST _pdr_known_components)
        set(PocoDDSRuntime_${_pdr_component}_FOUND FALSE)
        set(PocoDDSRuntime_NOT_FOUND_MESSAGE
            "Unknown PocoDDSRuntime component: ${_pdr_component}")
        set(PocoDDSRuntime_FOUND FALSE)
        return()
    endif()
    if(_pdr_component STREQUAL "Protocols" OR
       _pdr_component STREQUAL "Modbus" OR
       _pdr_component STREQUAL "ROS" OR
       _pdr_component STREQUAL "UDP" OR
       _pdr_component STREQUAL "WebTunnelProtocol")
        list(APPEND _pdr_poco_components Net)
    endif()
    if(_pdr_component STREQUAL "Plugins")
        list(APPEND _pdr_poco_components Zip XML)
    endif()
    if(_pdr_component STREQUAL "Protocols" OR _pdr_component STREQUAL "ROS")
        list(APPEND _pdr_poco_components JSON)
    endif()
    if(_pdr_component STREQUAL "Protocols" OR
       _pdr_component STREQUAL "ROS" OR
       _pdr_component STREQUAL "WebTunnelProtocol")
        list(APPEND _pdr_poco_components NetSSL)
    endif()
    if(_pdr_component STREQUAL "Protocols" OR _pdr_component STREQUAL "MQTT")
        set(_pdr_need_paho TRUE)
    endif()
endforeach()
list(REMOVE_DUPLICATES _pdr_poco_components)
find_dependency(Poco 1.15.3 CONFIG COMPONENTS ${_pdr_poco_components})
if(_pdr_need_paho)
    find_dependency(OpenSSL REQUIRED)
    find_dependency(eclipse-paho-mqtt-c CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PocoDDSRuntimeTargets.cmake")

set(_pdr_component_targets
    SDK PocoDDS::SDK
    Security PocoDDS::Security
    Plugins PocoDDS::Plugins
    Protocols PocoDDS::Protocols
    BtLE PocoDDS::BtLE
    CAN PocoDDS::CAN
    Modbus PocoDDS::Modbus
    MQTT PocoDDS::MQTT
    ROS PocoDDS::ROS
    SerialProtocol PocoDDS::SerialProtocol
    UDP PocoDDS::UDP
    WebTunnelProtocol PocoDDS::WebTunnelProtocol
    XBee PocoDDS::XBee)
list(LENGTH _pdr_component_targets _pdr_target_length)
math(EXPR _pdr_target_last "${_pdr_target_length} - 1")
foreach(_pdr_index RANGE 0 ${_pdr_target_last} 2)
    math(EXPR _pdr_target_index "${_pdr_index} + 1")
    list(GET _pdr_component_targets ${_pdr_index} _pdr_component)
    list(GET _pdr_component_targets ${_pdr_target_index} _pdr_target)
    if(TARGET ${_pdr_target})
        set(PocoDDSRuntime_${_pdr_component}_FOUND TRUE)
    else()
        set(PocoDDSRuntime_${_pdr_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(PocoDDSRuntime)

if("Plugins" IN_LIST PocoDDSRuntime_FIND_COMPONENTS)
    include("${CMAKE_CURRENT_LIST_DIR}/PocoDDSPlugins.cmake")
endif()

unset(_pdr_component_targets)
unset(_pdr_known_components)
unset(_pdr_need_paho)
unset(_pdr_poco_components)
