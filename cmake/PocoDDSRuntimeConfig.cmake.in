set(PocoDDSRuntime_CONFIGURATION_PARTICIPANT_BASELINE
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/PocoDDSRuntime/contracts/configuration-participant-baseline.json")
set(PocoDDSRuntime_CONFIGURATION_KEY_LIFECYCLE_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/configuration_key_lifecycle.py")
set(PocoDDSRuntime_CONFIGURATION_KEY_LIFECYCLE_BASELINE
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/PocoDDSRuntime/contracts/configuration-key-lifecycle-baseline.json")
set(PocoDDSRuntime_TEAM_CONTRACT_PACKAGE_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_package.py")
set(PocoDDSRuntime_TEAM_CONTRACT_IMPACT_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_impact.py")
set(PocoDDSRuntime_TEAM_CONTRACT_IMPACT_GATE_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_impact_gate.py")
set(PocoDDSRuntime_TEAM_CONTRACT_REGISTRY_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_registry.py")
set(PocoDDSRuntime_TEAM_CONTRACT_PROVENANCE_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_provenance.py")
set(PocoDDSRuntime_PDR_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/pdr.py")
set(PocoDDSRuntime_TEAM_CONTRACT_REGISTRY_REMOTE_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_registry_remote.py")
set(PocoDDSRuntime_TEAM_CONTRACT_REGISTRY_AUDIT_ARCHIVE_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_registry_audit_archive.py")
set(PocoDDSRuntime_TEAM_CONTRACT_REGISTRY_RECOVERY_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_registry_recovery.py")
set(PocoDDSRuntime_TEAM_CONTRACT_REGISTRY_STANDBY_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_registry_standby.py")
set(PocoDDSRuntime_TEAM_CONTRACT_REGISTRY_LEADER_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_registry_leader.py")
set(PocoDDSRuntime_TEAM_CONTRACT_REGISTRY_HANDOFF_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_registry_handoff.py")
set(PocoDDSRuntime_TEAM_CONTRACT_REGISTRY_ACCESS_POLICY_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/team_contract_registry_access_policy.py")
set(PocoDDSRuntime_PROCESS_FILE_LEASE_MODULE
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/process_file_lease.py")
set(PocoDDSRuntime_PROCESS_FILE_LEASE_TOOL
    "${PocoDDSRuntime_PROCESS_FILE_LEASE_MODULE}")
include("${CMAKE_CURRENT_LIST_DIR}/PocoDDSComponentTesting.cmake")

set(_pdr_component_targets
    SDK PocoDDS::SDK
    Security PocoDDS::Security
    Plugins PocoDDS::Plugins
    GatewayAPI PocoDDS::GatewayAPI
    WorkflowAPI PocoDDS::WorkflowAPI
    WorkflowCore PocoDDS::WorkflowCore
    StoreForwardAPI PocoDDS::StoreForwardAPI
    StoreForwardCore PocoDDS::StoreForwardCore
    TransportProviderAPI PocoDDS::TransportProviderAPI
    TransportProviderCore PocoDDS::TransportProviderCore
    CapabilitiesAPI PocoDDS::CapabilitiesAPI
    CapabilitiesCore PocoDDS::CapabilitiesCore
    CapabilitiesPersistence PocoDDS::CapabilitiesPersistence
    ConfigTransactionAPI PocoDDS::ConfigTransactionAPI
    ConfigTransactionCore PocoDDS::ConfigTransactionCore
    SchemaRegistryAPI PocoDDS::SchemaRegistryAPI
    SchemaRegistryCore PocoDDS::SchemaRegistryCore
    ResourceGovernanceAPI PocoDDS::ResourceGovernanceAPI
    ResourceGovernanceCore PocoDDS::ResourceGovernanceCore
    SchedulingAPI PocoDDS::SchedulingAPI
    SchedulingCore PocoDDS::SchedulingCore
    SchedulingConfiguration PocoDDS::SchedulingConfiguration
    ServiceClientAPI PocoDDS::ServiceClientAPI
    ServiceClientCore PocoDDS::ServiceClientCore
    ServiceClientTesting PocoDDS::ServiceClientTesting
    ServiceDependencyAPI PocoDDS::ServiceDependencyAPI
    ServiceDependencyCore PocoDDS::ServiceDependencyCore
    ServiceDirectoryAPI PocoDDS::ServiceDirectoryAPI
    ServiceDirectoryCore PocoDDS::ServiceDirectoryCore
    MembershipAPI PocoDDS::MembershipAPI
    MembershipCore PocoDDS::MembershipCore
    MembershipPersistence PocoDDS::MembershipPersistence
    LifecycleAPI PocoDDS::LifecycleAPI
    LifecycleCore PocoDDS::LifecycleCore
    LifecyclePersistence PocoDDS::LifecyclePersistence
    ProtocolCore PocoDDS::ProtocolCore
    Protocols PocoDDS::Protocols
    BtLE PocoDDS::BtLE
    CAN PocoDDS::CAN
    FastDDSAbiV1 PocoDDS::FastDDSAbiV1
    FastDDSCore PocoDDS::FastDDSCore
    FastDDSTransport PocoDDS::FastDDSTransport
    Modbus PocoDDS::Modbus
    MQTT PocoDDS::MQTT
    MQTTTransport PocoDDS::MQTTTransport
    ROS PocoDDS::ROS
    SerialProtocol PocoDDS::SerialProtocol
    UDP PocoDDS::UDP
    WebTunnelProtocol PocoDDS::WebTunnelProtocol
    XBee PocoDDS::XBee)
list(LENGTH _pdr_component_targets _pdr_target_length)
math(EXPR _pdr_target_last "${_pdr_target_length} - 1")
foreach(_pdr_index RANGE 0 ${_pdr_target_last} 2)
    math(EXPR _pdr_target_index "${_pdr_index} + 1")
    list(GET _pdr_component_targets ${_pdr_index} _pdr_component)
    list(GET _pdr_component_targets ${_pdr_target_index} _pdr_target)
    if(TARGET ${_pdr_target})
        set(PocoDDSRuntime_${_pdr_component}_FOUND TRUE)
    else()
        set(PocoDDSRuntime_${_pdr_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(PocoDDSRuntime)

if("Plugins" IN_LIST PocoDDSRuntime_FIND_COMPONENTS)
    include("${CMAKE_CURRENT_LIST_DIR}/PocoDDSPlugins.cmake")
endif()

unset(_pdr_component_targets)
unset(_pdr_known_components)
unset(_pdr_need_paho)
unset(_pdr_need_fastdds)
unset(_pdr_poco_components)
