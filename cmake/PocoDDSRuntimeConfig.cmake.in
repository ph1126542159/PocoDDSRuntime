@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PDRRuntimeCore CONFIG)

set(PocoDDSRuntime_PLUGIN_API_VERSION "@PDR_PLUGIN_API_VERSION@")
set(PocoDDSRuntime_PLUGIN_ABI_VERSION "@PDR_PLUGIN_ABI_VERSION@")
set(PocoDDSRuntime_PLUGIN_ABI_FINGERPRINT "@PDR_PLUGIN_ABI_FINGERPRINT@")
set(PocoDDSRuntime_PLUGIN_RUNTIME_RANGE "@PDR_PLUGIN_RUNTIME_RANGE@")
set(PocoDDSRuntime_PLUGIN_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(PocoDDSRuntime_PLUGIN_COMPILER_MAJOR "@PDR_PLUGIN_COMPILER_MAJOR@")

# No components keeps the original lightweight SDK behavior. Protocol users
# request either Protocols or one or more individual protocol components.
if(NOT PocoDDSRuntime_FIND_COMPONENTS)
    set(PocoDDSRuntime_FIND_COMPONENTS SDK)
endif()

set(PocoDDSRuntime_KNOWN_COMPONENTS
    SDK Security Plugins GatewayAPI WorkflowAPI WorkflowCore StoreForwardAPI StoreForwardCore TransportProviderAPI TransportProviderCore CapabilitiesAPI CapabilitiesCore CapabilitiesPersistence ConfigTransactionAPI ConfigTransactionCore SchemaRegistryAPI SchemaRegistryCore ResourceGovernanceAPI ResourceGovernanceCore SchedulingAPI SchedulingCore SchedulingConfiguration ServiceClientAPI ServiceClientCore ServiceClientTesting ServiceDependencyAPI ServiceDependencyCore ServiceDirectoryAPI ServiceDirectoryCore MembershipAPI MembershipCore MembershipPersistence LifecycleAPI LifecycleCore LifecyclePersistence ProtocolCore Protocols BtLE CAN FastDDSAbiV1 FastDDSCore FastDDSTransport Modbus MQTT MQTTTransport ROS SerialProtocol UDP WebTunnelProtocol XBee)
set(_pdr_known_components ${PocoDDSRuntime_KNOWN_COMPONENTS})
set(_pdr_poco_components Foundation Util JSON)
set(_pdr_need_paho FALSE)
set(_pdr_need_fastdds FALSE)
foreach(_pdr_component IN LISTS PocoDDSRuntime_FIND_COMPONENTS)
    if(NOT _pdr_component IN_LIST _pdr_known_components)
        set(PocoDDSRuntime_${_pdr_component}_FOUND FALSE)
        set(PocoDDSRuntime_NOT_FOUND_MESSAGE
            "Unknown PocoDDSRuntime component: ${_pdr_component}")
        set(PocoDDSRuntime_FOUND FALSE)
        return()
    endif()
    if(_pdr_component STREQUAL "Protocols" OR
       _pdr_component STREQUAL "Modbus" OR
       _pdr_component STREQUAL "ROS" OR
       _pdr_component STREQUAL "UDP" OR
       _pdr_component STREQUAL "WebTunnelProtocol")
        list(APPEND _pdr_poco_components Net)
    endif()
    if(_pdr_component STREQUAL "Plugins" OR
       _pdr_component STREQUAL "GatewayAPI" OR
       _pdr_component STREQUAL "WorkflowAPI" OR
       _pdr_component STREQUAL "WorkflowCore" OR
       _pdr_component STREQUAL "StoreForwardAPI" OR
       _pdr_component STREQUAL "StoreForwardCore" OR
       _pdr_component STREQUAL "TransportProviderAPI" OR
       _pdr_component STREQUAL "TransportProviderCore" OR
       _pdr_component STREQUAL "CapabilitiesAPI" OR
       _pdr_component STREQUAL "CapabilitiesCore" OR
       _pdr_component STREQUAL "CapabilitiesPersistence" OR
       _pdr_component STREQUAL "ConfigTransactionAPI" OR
       _pdr_component STREQUAL "ConfigTransactionCore" OR
       _pdr_component STREQUAL "ResourceGovernanceAPI" OR
       _pdr_component STREQUAL "SchedulingAPI" OR
       _pdr_component STREQUAL "SchedulingConfiguration" OR
       _pdr_component STREQUAL "ServiceClientAPI" OR
       _pdr_component STREQUAL "ServiceClientTesting" OR
       _pdr_component STREQUAL "ServiceDependencyAPI" OR
       _pdr_component STREQUAL "ServiceDirectoryAPI" OR
       _pdr_component STREQUAL "MembershipAPI" OR
       _pdr_component STREQUAL "LifecycleAPI" OR
       _pdr_component STREQUAL "SchemaRegistryAPI" OR
       _pdr_component STREQUAL "SchemaRegistryCore")
        list(APPEND _pdr_poco_components Zip XML)
    endif()
    if(_pdr_component STREQUAL "WorkflowCore" OR
       _pdr_component STREQUAL "StoreForwardCore" OR
       _pdr_component STREQUAL "CapabilitiesPersistence" OR
       _pdr_component STREQUAL "ConfigTransactionCore" OR
       _pdr_component STREQUAL "SchemaRegistryCore")
        list(APPEND _pdr_poco_components Data DataSQLite JSON)
    endif()
    if(_pdr_component STREQUAL "LifecyclePersistence" OR
       _pdr_component STREQUAL "MembershipPersistence")
        list(APPEND _pdr_poco_components Data DataSQLite JSON)
    endif()
    if(_pdr_component STREQUAL "CapabilitiesCore" OR
       _pdr_component STREQUAL "Protocols" OR _pdr_component STREQUAL "ROS")
        list(APPEND _pdr_poco_components JSON)
    endif()
    if(_pdr_component STREQUAL "Protocols" OR
       _pdr_component STREQUAL "ROS" OR
       _pdr_component STREQUAL "WebTunnelProtocol")
        list(APPEND _pdr_poco_components NetSSL)
    endif()
    if(_pdr_component STREQUAL "Protocols" OR _pdr_component STREQUAL "MQTT" OR
       _pdr_component STREQUAL "MQTTTransport")
        set(_pdr_need_paho TRUE)
    endif()
    if(_pdr_component STREQUAL "FastDDSAbiV1" OR
       _pdr_component STREQUAL "FastDDSCore" OR
       _pdr_component STREQUAL "FastDDSTransport")
        set(_pdr_need_fastdds TRUE)
    endif()
endforeach()
list(REMOVE_DUPLICATES _pdr_poco_components)
find_dependency(Poco 1.15.3 CONFIG COMPONENTS ${_pdr_poco_components})
find_dependency(OpenSSL REQUIRED)
if(_pdr_need_paho)
    find_dependency(eclipse-paho-mqtt-c CONFIG REQUIRED)
endif()
if(_pdr_need_fastdds)
    find_dependency(fastdds 3 CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PocoDDSRuntimeTargets.cmake")

set(PocoDDSRuntime_COMPONENT_CONTRACT_TEST_TOOL
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/component_contract_test.py")
