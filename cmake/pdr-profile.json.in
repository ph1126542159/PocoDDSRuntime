{
  "schemaVersion": 1,
  "name": "@PDR_PROFILE@",
  "version": "@PROJECT_VERSION@",
  "framework": {
    "family": "@PDR_FRAMEWORK_FAMILY@",
    "model": "@PDR_HOST_MODEL@",
    "manifest": "share/PocoDDSRuntime/pdr-framework-model.json"
  },
  "features": {
    "webui": @PDR_PROFILE_WEBUI@,
    "launcher": @PDR_PROFILE_LAUNCHER@,
    "qt3d": @PDR_PROFILE_QT3D@,
    "observability": @PDR_PROFILE_OBSERVABILITY@,
    "dataModules": @PDR_PROFILE_DATA_MODULES@
  }
}
