<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>PocoDDS Protocol Gateway</name>
    <symbolicName>pdr.protocol.gateway</symbolicName>
    <version>0.1.0</version>
    <vendor>PocoDDSRuntime</vendor>
    <activator>
      <class>PocoDDS::Services::ProtocolGatewayActivator</class>
      <library>pdr.protocol.gateway</library>
    </activator>
    <lazyStart>false</lazyStart>
    <runLevel>110</runLevel>
    <requiredBundles>
      <bundle>
        <symbolicName>osp.core</symbolicName>
        <version>[1.0.0,2.0.0)</version>
      </bundle>
    </requiredBundles>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
  </code>
</bundlespec>
