<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>PocoDDS Runtime Service Client</name>
    <symbolicName>pdr.service.serviceClientRuntime</symbolicName>
    <version>1.0.0</version>
    <vendor>PocoDDSRuntime</vendor>
    <activator>
      <class>PocoDDS::ServiceClient::ServiceClientRuntimeBundleActivator</class>
      <library>pdr.service.serviceClientRuntime</library>
    </activator>
    <lazyStart>false</lazyStart>
    <runLevel>109</runLevel>
    <requiredBundles>
      <bundle><symbolicName>osp.core</symbolicName><version>[1.0.0,2.0.0)</version></bundle>
      <bundle><symbolicName>osp.web</symbolicName><version>[1.0.0,2.0.0)</version></bundle>
      <bundle><symbolicName>pdr.platform.managementAuth</symbolicName><version>[1.0.0,2.0.0)</version></bundle>
      <bundle><symbolicName>pdr.service.resourceGovernor</symbolicName><version>[1.0.0,2.0.0)</version></bundle>
      <bundle><symbolicName>pdr.service.serviceDirectoryRuntime</symbolicName><version>[1.0.0,2.0.0)</version></bundle>
    </requiredBundles>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
  </code>
  <files>bundle/*</files>
</bundlespec>
