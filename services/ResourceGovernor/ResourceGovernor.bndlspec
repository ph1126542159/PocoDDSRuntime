<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>PocoDDS Bundle Resource Governor</name>
    <symbolicName>pdr.service.resourceGovernor</symbolicName>
    <version>1.0.0</version>
    <vendor>PocoDDSRuntime</vendor>
    <activator>
      <class>PocoDDS::ResourceGovernance::ResourceGovernorBundleActivator</class>
      <library>pdr.service.resourceGovernor</library>
    </activator>
    <lazyStart>false</lazyStart>
    <runLevel>108</runLevel>
    <requiredBundles>
      <bundle>
        <symbolicName>osp.core</symbolicName>
        <version>[1.0.0,2.0.0)</version>
      </bundle>
      <bundle>
        <symbolicName>osp.web</symbolicName>
        <version>[1.0.0,2.0.0)</version>
      </bundle>
      <bundle>
        <symbolicName>pdr.platform.managementAuth</symbolicName>
        <version>[1.0.0,2.0.0)</version>
      </bundle>
    </requiredBundles>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
  </code>
  <files>bundle/*</files>
</bundlespec>
