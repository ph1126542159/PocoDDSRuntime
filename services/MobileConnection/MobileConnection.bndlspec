<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>PocoDDS Mobile Connection Service</name>
    <symbolicName>pdr.service.mobile</symbolicName>
    <version>1.0.0</version>
    <vendor>PocoDDSRuntime</vendor>
    <activator>
      <class>IoT::MobileConnection::BundleActivator</class>
      <library>pdr.service.mobile</library>
    </activator>
    <lazyStart>false</lazyStart>
    <runLevel>240</runLevel>
    <requiredBundles>
      <bundle><symbolicName>osp.core</symbolicName><version>[1.0.0, 2.0.0)</version></bundle>
    </requiredBundles>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
  </code>
</bundlespec>
