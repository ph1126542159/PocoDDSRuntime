<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>PocoDDS Units of Measure Service</name>
    <symbolicName>pdr.service.units</symbolicName>
    <version>1.0.0</version>
    <vendor>PocoDDSRuntime</vendor>
    <activator>
      <class>IoT::UnitsOfMeasure::BundleActivator</class>
      <library>pdr.service.units</library>
    </activator>
    <lazyStart>false</lazyStart>
    <runLevel>200</runLevel>
    <requiredBundles>
      <bundle>
        <symbolicName>osp.core</symbolicName>
        <version>[1.0.0, 2.0.0)</version>
      </bundle>
    </requiredBundles>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
  </code>
  <files>
    bundle/*
  </files>
</bundlespec>
