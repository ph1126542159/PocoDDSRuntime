<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>PocoDDS Network Environment Service</name>
    <symbolicName>pdr.service.network</symbolicName>
    <version>1.0.0</version>
    <vendor>PocoDDSRuntime</vendor>
    <activator>
      <class>IoT::NetworkEnvironment::BundleActivator</class>
      <library>pdr.service.network</library>
    </activator>
    <lazyStart>false</lazyStart>
    <runLevel>210</runLevel>
    <requiredBundles>
      <bundle>
        <symbolicName>osp.core</symbolicName>
        <version>[1.0.0, 2.0.0)</version>
      </bundle>
    </requiredBundles>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
  </code>
</bundlespec>
