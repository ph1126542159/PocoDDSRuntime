<?xml version="1.0"?>
<bundlespec>
  <manifest>
    <name>PocoDDS Web Event Service</name>
    <symbolicName>pdr.service.webEvent</symbolicName>
    <version>1.0.0</version>
    <vendor>PocoDDSRuntime</vendor>
    <activator>
      <class>PocoDDS::Services::WebEventBundleActivator</class>
      <library>pdr.service.webEvent</library>
    </activator>
    <lazyStart>false</lazyStart>
    <runLevel>230</runLevel>
    <requiredBundles>
      <bundle><symbolicName>osp.core</symbolicName><version>[1.0.0, 2.0.0)</version></bundle>
    </requiredBundles>
  </manifest>
  <code>
    ${bin}/*.dll,
    ${bin}/*.pdb,
    bin/${osName}/${osArch}/*.so,
    bin/${osName}/${osArch}/*.dylib
  </code>
</bundlespec>
